{% extends "components/layout-login.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/signup.css">
{% endblock %}

{% block title %}Registro de Administrador{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    email: '',
    password: '',
    showPassword: false,
    submitting: false,
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    },
    get isEmailValid() {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.email.trim());
    },
    get hasMinLength() {
      return this.password.length >= 8;
    },
    get hasNumber() {
      return /\d/.test(this.password);
    },
    get isFormValid() {
      return this.isEmailValid && this.hasMinLength;
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>

  <main class="auth-card w3-animate-opacity">
    {{ include(
      'components/card-header.twig',
      {content: 'Creación de cuenta de administrador'}
    ) }}

    <!-- Contenido del formulario -->
    <div class="w3-container" style="padding: 24px 28px 36px;">
      {{ include('components/alert-error.twig') }}

      <form
        method="post"
        action="/registrarse"
        novalidate
        @submit="submitting = true"
      >
        <!-- Campo: Correo Electrónico -->
        <div class="w3-margin-bottom">
          <label for="email" class="w3-small w3-bold" style="display: block; margin-bottom: 6px;">
            Correo electrónico
          </label>
          <input
            id="email"
            class="form-input"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="ejemplo@correo.com"
            x-model="email"
            :style="email.length > 0 && !isEmailValid ? 'border-color: var(--brand-red) !important;' : ''"
          >
          <template x-if="email.length > 0 && !isEmailValid">
            <span class="w3-tiny" style="color: var(--brand-red); display: block; margin-top: 4px;">
              Ingresa una dirección de correo electrónico válida.
            </span>
          </template>
        </div>

        <!-- Campo: Contraseña -->
        <div class="w3-margin-bottom">
          <label for="password" class="w3-small w3-bold" style="display: block; margin-bottom: 6px;">
            Contraseña
          </label>
          <div class="input-wrapper">
            <input
              id="password"
              class="form-input"
              :type="showPassword ? 'text' : 'password'"
              name="{{ passwordKey }}"
              required
              autocomplete="new-password"
              placeholder="Ingresa una clave segura"
              x-model="password"
            >
            <button
              type="button"
              class="toggle-password-btn"
              @click="showPassword = !showPassword"
              :aria-label="showPassword ? 'Ocultar contraseña' : 'Ver contraseña'"
              title="Mostrar u ocultar contraseña"
            >
              <!-- Ícono ojo abierto -->
              <svg x-show="!showPassword" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <!-- Ícono ojo cerrado -->
              <svg x-show="showPassword" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display: none;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
              </svg>
            </button>
          </div>

          <!-- Indicadores de requisitos con acento rojo y gris -->
          <div class="w3-padding-small w3-margin-top" x-show="password.length > 0" x-transition>
            <div class="rule-item" :class="hasMinLength ? 'valid' : 'invalid'">
              <span x-text="hasMinLength ? '✓' : '•'"></span>
              <span>Mínimo 8 caracteres</span>
            </div>
            <div class="rule-item" :class="hasNumber ? 'valid' : 'invalid'">
              <span x-text="hasNumber ? '✓' : '•'"></span>
              <span>Al menos un número</span>
            </div>
          </div>
        </div>

        <!-- Botón de Envío en Rojo Racing con Hover Negro/Rojo Oscuro -->
        <div class="w3-margin-top">
          <button
            type="submit"
            class="btn-submit"
            :disabled="submitting || !isFormValid"
          >
            <span x-show="!submitting">Registrar Cuenta</span>
            <span x-show="submitting" style="display: none;">Procesando registro...</span>
          </button>
        </div>
      </form>

      {{ include('components/footer-login.twig', {
        text: '¿Ya tienes cuenta creada?',
        href: '/auth/login',
        link_text: 'Iniciar sesión',
        link_class: 'link-login',
      }) }}
    </div>
  </main>

</body>
{% endblock %}
