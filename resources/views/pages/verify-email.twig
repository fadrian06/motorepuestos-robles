{% extends "components/layout-login.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/verify-email.css">
{% endblock %}

{% block title %}Verificar Correo{% endblock %}

{% block content %}
<body x-data="{ submitting: false }">
  <main class="auth-card w3-animate-opacity">
    {{ include(
      'components/card-header.twig',
      {content: 'Verificación de cuenta'}
    ) }}

    <!-- Contenido del formulario -->
    <div class="w3-container" style="padding: 28px 28px 36px;">
      {{ include('components/alert-error.twig') }}

      <div class="w3-center">
        <!-- Ícono de correo -->
        <div class="status-badge">
          <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>

        <h2 style="margin: 0 0 10px; font-size: 18px; font-weight: 700;">
          Confirma tu correo electrónico
        </h2>
        
        <p class="w3-small" style="margin: 0 0 20px; color: #a1a1aa; line-height: 1.6;">
          Para activar tu cuenta y acceder a las funciones del sistema, pulsa el botón a continuación para generar y enviar el enlace de verificación a tu correo electrónico.
        </p>

        <!-- Caja de ayuda con alto contraste -->
        <div class="info-box w3-left-align">
          <p>
            <strong>Paso siguiente:</strong> Al presionar el botón se enviará un mensaje a tu correo. Revisa tu bandeja de entrada (y la carpeta de correo no deseado o spam) para completar la activación.
          </p>
        </div>
      </div>

      <!-- Formulario para enviar el correo -->
      <form
        method="post"
        novalidate
        @submit="submitting = true"
      >
        <button
          type="submit"
          class="btn-submit"
          :disabled="submitting"
        >
          <span x-show="!submitting">Enviar correo de verificación</span>
          <span x-show="submitting" style="display: none;">Enviando correo...</span>
        </button>
      </form>

      {{ include('components/footer-login.twig', {
        text: '¿Deseas ingresar con otra cuenta?',
        href: '/salir',
        link_text: 'Cerrar sesión',
        link_class: 'link-action',
      }) }}
    </div>
  </main>
</body>
{% endblock %}
