{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/register-client.css">
{% endblock %}

{% block title %}Registrar Cliente{% endblock %}

{% block content %}
<body x-data="{ sidebarOpen: false, submitting: false }">
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/clientes'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Registrar Cliente',
      badge: 'Formulario',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan y encabezado -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/clientes" style="color: inherit; text-decoration: none;">Clientes</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Nuevo Registro</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Registrar Nuevo Cliente
          </h2>
          <a href="/clientes" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Directorio
          </a>
        </div>
      </div>

      <!-- Tarjeta del Formulario (Centrada y limpia) -->
      <div style="max-width: 640px; margin: 0 auto;">
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Datos del Comprador</span>
            </div>
            <span class="badge-pill badge-red">Requerido</span>
          </div>

          <div style="padding: 24px;">
            {{ include('components/alert-error.twig') }}

            <form
              method="post"
              novalidate
              @submit="submitting = true"
            >
              <div class="form-group">
                <label for="client_name" class="form-label">
                  Nombre Completo o Razón Social <span style="color: var(--brand-red);">*</span>
                </label>
                <input
                  type="text"
                  id="client_name"
                  name="name"
                  class="form-input"
                  required
                  placeholder="Ej: Taller Mecánico San Rafael / Pedro Martínez"
                  autofocus
                >
                <div class="form-hint">
                  Ingresa el nombre distintivo del comprador o taller. Este nombre será utilizado en cotizaciones, compras por lote y facturas.
                </div>
              </div>

              <div style="margin-top: 28px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--w3-border-light); padding-top: 20px;">
                <a href="/clientes" class="btn-secondary">
                  Cancelar
                </a>
                <button
                  type="submit"
                  class="btn-brand"
                  :disabled="submitting"
                >
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span x-text="submitting ? 'Guardando...' : 'Guardar Cliente'"></span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Registro de clientes'},
    ) }}
  </div>

</body>
{% endblock %}
