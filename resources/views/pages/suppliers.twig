{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/suppliers.css">
{% endblock %}

{% block title %}Directorio de Proveedores{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    search: '',
    deleteModalOpen: false,
    supplierToDelete: null,
    suppliersList: [
      {% for supplier in suppliers %}
      {
        id: {{ supplier.id }},
        name: '{{ supplier.name|e('js') }}',
        tax_id: '{{ supplier.tax_id|e('js') }}',
        alias: '{{ supplier.alias|e('js') }}',
        seller: '{{ supplier.seller|e('js') }}',
        phone: '{{ supplier.phone|e('js') }}',
        address: '{{ supplier.address|e('js') }}'
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    },
    get filteredSuppliers() {
      if (!this.search.trim()) {
        return this.suppliersList;
      }
      const q = this.search.toLowerCase().trim();
      return this.suppliersList.filter(s => 
        (s.name && s.name.toLowerCase().includes(q)) ||
        (s.tax_id && s.tax_id.toLowerCase().includes(q)) ||
        (s.alias && s.alias.toLowerCase().includes(q)) ||
        (s.seller && s.seller.toLowerCase().includes(q)) ||
        (s.phone && s.phone.toLowerCase().includes(q)) ||
        (s.address && s.address.toLowerCase().includes(q))
      );
    },
    openDelete(supplier) {
      this.supplierToDelete = supplier;
      this.deleteModalOpen = true;
    },
    confirmDelete() {
      if (this.supplierToDelete) {
        window.location.href = '/proveedores/' + this.supplierToDelete.id + '/eliminar';
      }
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/proveedores'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Directorio de Proveedores',
      badge: 'Compras',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Barra de navegación y acción principal -->
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
          <div style="font-size: 12px; color: #71717a; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
            <span>&rsaquo;</span>
            <span style="color: var(--brand-red); font-weight: 600;">Proveedores</span>
          </div>
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Proveedores Registrados
          </h2>
          <p style="margin: 4px 0 0; font-size: 13px; color: #71717a;">
            Administra las casas de repuestos, importadoras y distribuidores mayoristas asociados a tus compras por lote.
          </p>
        </div>

        <div>
          <a href="/proveedores/registrar" class="btn-brand" style="padding: 10px 18px; font-size: 14px;">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Nuevo Proveedor</span>
          </a>
        </div>
      </div>

      <!-- Métricas rápidas -->
      <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div class="kpi-card">
          <div class="kpi-icon red">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Total Registrados</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px;">{{ suppliers|length }}</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon gray">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Alianzas Comerciales</div>
            <div style="font-size: 18px; font-weight: 800; margin-top: 4px; color: #22c55e;">Activas</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon red">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Abastecimiento</div>
            <div style="font-size: 18px; font-weight: 800; margin-top: 4px;">Por Lote</div>
          </div>
        </div>
      </section>

      <!-- Tabla y Filtro -->
      <div class="panel-card">
        <div class="panel-header">
          <!-- Buscador en vivo -->
          <div class="search-wrapper">
            <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              placeholder="Buscar por nombre, RIF, alias, vendedor..."
              x-model="search"
              aria-label="Buscar proveedor"
            >
          </div>

          <!-- Contador de proveedores -->
          <div style="font-size: 13px; color: #71717a; font-weight: 500;">
            <span x-text="'Mostrando ' + filteredSuppliers.length + ' de ' + suppliersList.length + ' proveedores'"></span>
          </div>
        </div>

        {% if suppliers is empty %}
          <!-- Estado Vacío Inicial -->
          <div style="text-align: center; padding: 64px 20px;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background-color: rgba(220, 38, 38, 0.1); color: var(--brand-red); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
              <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700;">No hay proveedores registrados</h3>
            <p style="margin: 0 auto 20px; font-size: 13px; color: #71717a; max-width: 440px; line-height: 1.5;">
              Aún no tienes proveedores en el sistema. Registra las empresas distribuidoras y fabricantes para asociarlas a tus compras e inventario por lote.
            </p>
            <a href="/proveedores/registrar" class="btn-brand">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Registrar Primer Proveedor</span>
            </a>
          </div>
        {% else %}
          <div style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 70px;"># ID</th>
                  <th>Proveedor / Razón Social</th>
                  <th>RIF / Fiscal</th>
                  <th>Contacto / Vendedor</th>
                  <th>Dirección</th>
                  <th style="text-align: right; width: 170px;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="supplier in filteredSuppliers" :key="supplier.id">
                  <tr>
                    <!-- ID -->
                    <td style="font-weight: 700; color: #71717a; font-family: monospace;">
                      #<span x-text="String(supplier.id).padStart(3, '0')"></span>
                    </td>

                    <!-- Proveedor y Alias -->
                    <td>
                      <div style="display: flex; align-items: center; gap: 12px;">
                        <div class="supplier-avatar" x-text="supplier.name ? supplier.name.substring(0, 1).toUpperCase() : 'P'"></div>
                        <div>
                          <div style="font-weight: 700; font-size: 14px;" x-text="supplier.name"></div>
                          <div style="font-size: 12px; color: #71717a; margin-top: 1px; display: flex; align-items: center; gap: 6px;">
                            <span>Alias:</span>
                            <span style="font-weight: 600; color: var(--brand-red);" x-text="supplier.alias"></span>
                          </div>
                        </div>
                      </div>
                    </td>

                    <!-- RIF / Identificación Fiscal -->
                    <td>
                      <span class="badge-pill badge-gray" style="font-family: monospace; font-size: 12px;" x-text="supplier.tax_id"></span>
                    </td>

                    <!-- Vendedor y Teléfono -->
                    <td>
                      <div>
                        <div style="font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 5px;">
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: #71717a;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                          </svg>
                          <span x-text="supplier.seller"></span>
                        </div>
                        <div style="font-size: 12px; color: #71717a; margin-top: 2px;">
                          <a :href="'tel:' + supplier.phone" style="color: inherit; text-decoration: none;" class="w3-hover-text-red">
                            <span x-text="supplier.phone"></span>
                          </a>
                        </div>
                      </div>
                    </td>

                    <!-- Dirección -->
                    <td>
                      <div style="max-width: 240px; font-size: 13px; color: #a1a1aa; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" :title="supplier.address" x-text="supplier.address"></div>
                    </td>

                    <!-- Acciones -->
                    <td style="text-align: right;">
                      <div style="display: inline-flex; align-items: center; gap: 8px;">
                        <!-- Editar -->
                        <a
                          :href="'/proveedores/' + supplier.id"
                          class="btn-secondary"
                          style="padding: 6px 10px; font-size: 12px;"
                          title="Editar proveedor"
                        >
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                          </svg>
                          <span>Editar</span>
                        </a>

                        <!-- Eliminar -->
                        <button
                          type="button"
                          class="btn-danger-outline"
                          @click="openDelete(supplier)"
                          title="Eliminar proveedor"
                        >
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                          <span>Eliminar</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>

          <!-- Si la búsqueda no arroja resultados -->
          <div
            x-show="filteredSuppliers.length === 0"
            style="text-align: center; padding: 48px 20px; display: none;"
          >
            <div style="font-size: 14px; font-weight: 600; margin-bottom: 4px;">No se encontraron resultados</div>
            <div style="font-size: 13px; color: #71717a;">
              No existe ningún proveedor que coincida con "<strong x-text="search"></strong>".
            </div>
          </div>
        {% endif %}
      </div>
    </main>

    <!-- Modal de confirmación para eliminar -->
    <div
      class="modal-backdrop"
      x-show="deleteModalOpen"
      x-transition:enter="w3-animate-opacity"
      x-transition:leave="w3-animate-opacity"
      style="display: none;"
      @click.self="deleteModalOpen = false"
    >
      <div class="modal-box">
        <div style="display: flex; align-items: flex-start; gap: 14px;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 style="margin: 0; font-size: 17px; font-weight: 700;">¿Eliminar proveedor?</h3>
            <p style="margin: 8px 0 0; font-size: 13px; color: #71717a; line-height: 1.5;">
              ¿Estás seguro de que deseas eliminar al proveedor <strong x-text="supplierToDelete ? supplierToDelete.name : ''"></strong> (<span x-text="supplierToDelete ? supplierToDelete.tax_id : ''"></span>)? Esta acción borrará el registro de forma permanente.
            </p>
          </div>
        </div>

        <div style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 10px;">
          <button
            type="button"
            class="btn-secondary"
            @click="deleteModalOpen = false"
          >
            Cancelar
          </button>
          <button
            type="button"
            class="btn-brand"
            style="background-color: #ef4444; border-color: #ef4444;"
            @click="confirmDelete()"
          >
            Sí, eliminar
          </button>
        </div>
      </div>
    </div>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Directorio de proveedores'},
    ) }}
  </div>

</body>
{% endblock %}
