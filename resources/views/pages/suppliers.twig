{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/suppliers.css">
{% endblock %}

{% block title %}Directorio de Proveedores{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    search: '',
    deleteModalOpen: false,
    supplierToDelete: null,
    suppliersList: [
      {% for supplier in suppliers %}
      {
        id: {{ supplier.id }},
        name: '{{ supplier.name|e('js') }}',
        tax_id: '{{ supplier.tax_id|e('js') }}',
        alias: '{{ supplier.alias|e('js') }}',
        seller: '{{ supplier.seller|e('js') }}',
        phone: '{{ supplier.phone|e('js') }}',
        address: '{{ supplier.address|e('js') }}'
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    },
    get filteredSuppliers() {
      if (!this.search.trim()) {
        return this.suppliersList;
      }
      const q = this.search.toLowerCase().trim();
      return this.suppliersList.filter(s => 
        (s.name && s.name.toLowerCase().includes(q)) ||
        (s.tax_id && s.tax_id.toLowerCase().includes(q)) ||
        (s.alias && s.alias.toLowerCase().includes(q)) ||
        (s.seller && s.seller.toLowerCase().includes(q)) ||
        (s.phone && s.phone.toLowerCase().includes(q)) ||
        (s.address && s.address.toLowerCase().includes(q))
      );
    },
    openDelete(supplier) {
      this.supplierToDelete = supplier;
      this.deleteModalOpen = true;
    },
    confirmDelete() {
      if (this.supplierToDelete) {
        window.location.href = '/proveedores/' + this.supplierToDelete.id + '/eliminar';
      }
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>

  <!-- Telón de fondo móvil -->
  <div
    class="sidebar-backdrop"
    x-show="sidebarOpen"
    @click="sidebarOpen = false"
    x-transition:enter="w3-animate-opacity"
    x-transition:leave="w3-animate-opacity"
    style="display: none;"
  ></div>

  <!-- Barra lateral (Sidebar) -->
  <aside class="app-sidebar" :class="{ 'open': sidebarOpen }">
    <div class="sidebar-brand">
      <img
        src="/resources/images/banner.jpg"
        alt="{{ _ENV['APP_NAME'] }}"
        class="brand-avatar"
        onerror="this.style.display='none'"
      >
      <div style="overflow: hidden;">
        <div style="font-weight: 800; font-size: 13px; text-transform: uppercase; color: #ffffff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {{ _ENV['APP_NAME'] }}
        </div>
        <div style="font-size: 11px; color: #a1a1aa; display: flex; align-items: center; gap: 4px; margin-top: 2px;">
          <span style="width: 7px; height: 7px; border-radius: 50%; background-color: #22c55e; display: inline-block;"></span>
          Sistema en línea
        </div>
      </div>
    </div>

    <!-- Navegación principal -->
    <nav style="padding: 8px 0 24px;">
      <div class="nav-group-title">Principal</div>
      
      <a href="/" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Dashboard</span>
      </a>

      <div class="nav-group-title">Gestión de Negocio</div>

      <a href="/clientes" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span>Clientes</span>
      </a>

      <a href="/proveedores" class="nav-item active">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <span>Proveedores</span>
      </a>

      <a href="/vendedores" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span>Vendedores</span>
      </a>

      <a href="/cotizaciones" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Tasas de Cambio</span>
      </a>

      <div class="nav-group-title">Módulos de Repuestos</div>

      <a href="/productos" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <span>Catálogo de Productos</span>
      </a>

      <a href="/compras" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <span>Inventario y Lotes</span>
      </a>

      <a href="/ventas" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span>Ventas y Facturación</span>
      </a>

      <div class="nav-group-title">Sistema y Seguridad</div>

      <a href="/actualizar-clave" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Actualizar Contraseña</span>
      </a>

      <a href="/salir" class="nav-item" style="color: #ef4444;">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Cerrar Sesión</span>
      </a>
    </nav>
  </aside>

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    <!-- Topbar -->
    <header class="app-topbar">
      <div style="display: flex; align-items: center; gap: 14px;">
        <button
          type="button"
          class="btn-secondary w3-hide-large"
          @click="sidebarOpen = true"
          aria-label="Abrir menú"
        >
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <h1 style="margin: 0; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <span>Directorio de Proveedores</span>
          <span class="badge-pill badge-red w3-hide-small">Compras</span>
        </h1>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <button
          type="button"
          class="btn-secondary"
          @click="isDarkMode = !isDarkMode"
          :title="isDarkMode ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'"
          aria-label="Alternar modo de color"
        >
          <svg x-show="isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg x-show="!isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <a href="/salir" class="btn-brand" style="padding: 7px 14px;" title="Cerrar sesión actual">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="w3-hide-small">Salir</span>
        </a>
      </div>
    </header>

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Barra de navegación y acción principal -->
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
          <div style="font-size: 12px; color: #71717a; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
            <span>&rsaquo;</span>
            <span style="color: var(--brand-red); font-weight: 600;">Proveedores</span>
          </div>
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Proveedores Registrados
          </h2>
          <p style="margin: 4px 0 0; font-size: 13px; color: #71717a;">
            Administra las casas de repuestos, importadoras y distribuidores mayoristas asociados a tus compras por lote.
          </p>
        </div>

        <div>
          <a href="/proveedores/registrar" class="btn-brand" style="padding: 10px 18px; font-size: 14px;">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Nuevo Proveedor</span>
          </a>
        </div>
      </div>

      <!-- Métricas rápidas -->
      <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div class="kpi-card">
          <div class="kpi-icon red">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Total Registrados</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px;">{{ suppliers|length }}</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon gray">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Alianzas Comerciales</div>
            <div style="font-size: 18px; font-weight: 800; margin-top: 4px; color: #22c55e;">Activas</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon red">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Abastecimiento</div>
            <div style="font-size: 18px; font-weight: 800; margin-top: 4px;">Por Lote</div>
          </div>
        </div>
      </section>

      <!-- Tabla y Filtro -->
      <div class="panel-card">
        <div class="panel-header">
          <!-- Buscador en vivo -->
          <div class="search-wrapper">
            <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              placeholder="Buscar por nombre, RIF, alias, vendedor..."
              x-model="search"
              aria-label="Buscar proveedor"
            >
          </div>

          <!-- Contador de proveedores -->
          <div style="font-size: 13px; color: #71717a; font-weight: 500;">
            <span x-text="'Mostrando ' + filteredSuppliers.length + ' de ' + suppliersList.length + ' proveedores'"></span>
          </div>
        </div>

        {% if suppliers is empty %}
          <!-- Estado Vacío Inicial -->
          <div style="text-align: center; padding: 64px 20px;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background-color: rgba(220, 38, 38, 0.1); color: var(--brand-red); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
              <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700;">No hay proveedores registrados</h3>
            <p style="margin: 0 auto 20px; font-size: 13px; color: #71717a; max-width: 440px; line-height: 1.5;">
              Aún no tienes proveedores en el sistema. Registra las empresas distribuidoras y fabricantes para asociarlas a tus compras e inventario por lote.
            </p>
            <a href="/proveedores/registrar" class="btn-brand">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Registrar Primer Proveedor</span>
            </a>
          </div>
        {% else %}
          <div style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 70px;"># ID</th>
                  <th>Proveedor / Razón Social</th>
                  <th>RIF / Fiscal</th>
                  <th>Contacto / Vendedor</th>
                  <th>Dirección</th>
                  <th style="text-align: right; width: 170px;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="supplier in filteredSuppliers" :key="supplier.id">
                  <tr>
                    <!-- ID -->
                    <td style="font-weight: 700; color: #71717a; font-family: monospace;">
                      #<span x-text="String(supplier.id).padStart(3, '0')"></span>
                    </td>

                    <!-- Proveedor y Alias -->
                    <td>
                      <div style="display: flex; align-items: center; gap: 12px;">
                        <div class="supplier-avatar" x-text="supplier.name ? supplier.name.substring(0, 1).toUpperCase() : 'P'"></div>
                        <div>
                          <div style="font-weight: 700; font-size: 14px;" x-text="supplier.name"></div>
                          <div style="font-size: 12px; color: #71717a; margin-top: 1px; display: flex; align-items: center; gap: 6px;">
                            <span>Alias:</span>
                            <span style="font-weight: 600; color: var(--brand-red);" x-text="supplier.alias"></span>
                          </div>
                        </div>
                      </div>
                    </td>

                    <!-- RIF / Identificación Fiscal -->
                    <td>
                      <span class="badge-pill badge-gray" style="font-family: monospace; font-size: 12px;" x-text="supplier.tax_id"></span>
                    </td>

                    <!-- Vendedor y Teléfono -->
                    <td>
                      <div>
                        <div style="font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 5px;">
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: #71717a;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                          </svg>
                          <span x-text="supplier.seller"></span>
                        </div>
                        <div style="font-size: 12px; color: #71717a; margin-top: 2px;">
                          <a :href="'tel:' + supplier.phone" style="color: inherit; text-decoration: none;" class="w3-hover-text-red">
                            <span x-text="supplier.phone"></span>
                          </a>
                        </div>
                      </div>
                    </td>

                    <!-- Dirección -->
                    <td>
                      <div style="max-width: 240px; font-size: 13px; color: #a1a1aa; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" :title="supplier.address" x-text="supplier.address"></div>
                    </td>

                    <!-- Acciones -->
                    <td style="text-align: right;">
                      <div style="display: inline-flex; align-items: center; gap: 8px;">
                        <!-- Editar -->
                        <a
                          :href="'/proveedores/' + supplier.id"
                          class="btn-secondary"
                          style="padding: 6px 10px; font-size: 12px;"
                          title="Editar proveedor"
                        >
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                          </svg>
                          <span>Editar</span>
                        </a>

                        <!-- Eliminar -->
                        <button
                          type="button"
                          class="btn-danger-outline"
                          @click="openDelete(supplier)"
                          title="Eliminar proveedor"
                        >
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                          <span>Eliminar</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>

          <!-- Si la búsqueda no arroja resultados -->
          <div
            x-show="filteredSuppliers.length === 0"
            style="text-align: center; padding: 48px 20px; display: none;"
          >
            <div style="font-size: 14px; font-weight: 600; margin-bottom: 4px;">No se encontraron resultados</div>
            <div style="font-size: 13px; color: #71717a;">
              No existe ningún proveedor que coincida con "<strong x-text="search"></strong>".
            </div>
          </div>
        {% endif %}
      </div>
    </main>

    <!-- Modal de confirmación para eliminar -->
    <div
      class="modal-backdrop"
      x-show="deleteModalOpen"
      x-transition:enter="w3-animate-opacity"
      x-transition:leave="w3-animate-opacity"
      style="display: none;"
      @click.self="deleteModalOpen = false"
    >
      <div class="modal-box">
        <div style="display: flex; align-items: flex-start; gap: 14px;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 style="margin: 0; font-size: 17px; font-weight: 700;">¿Eliminar proveedor?</h3>
            <p style="margin: 8px 0 0; font-size: 13px; color: #71717a; line-height: 1.5;">
              ¿Estás seguro de que deseas eliminar al proveedor <strong x-text="supplierToDelete ? supplierToDelete.name : ''"></strong> (<span x-text="supplierToDelete ? supplierToDelete.tax_id : ''"></span>)? Esta acción borrará el registro de forma permanente.
            </p>
          </div>
        </div>

        <div style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 10px;">
          <button
            type="button"
            class="btn-secondary"
            @click="deleteModalOpen = false"
          >
            Cancelar
          </button>
          <button
            type="button"
            class="btn-brand"
            style="background-color: #ef4444; border-color: #ef4444;"
            @click="confirmDelete()"
          >
            Sí, eliminar
          </button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer style="padding: 20px 24px; border-top: 1px solid var(--w3-border-light); font-size: 12px; color: #71717a; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <div>
        &copy; 2026 <strong>{{ _ENV['APP_NAME'] }}</strong>. Directorio de proveedores.
      </div>
      <div>
        Sistema de inventario por lote y trazabilidad comercial.
      </div>
    </footer>
  </div>

</body>
{% endblock %}
