<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Comprobante de Venta {{ sale.code }} - {{ _ENV['APP_NAME'] }}</title>
  <link rel="stylesheet" href="/resources/styles/w3.css">
  <script defer src="/resources/scripts/alpinejs/dist/cdn.min.js"></script>
  <style>
    :root {
      --brand-red: #dc2626;
      --brand-red-hover: #b91c1c;
      --brand-red-glow: rgba(220, 38, 38, 0.25);
      --brand-black: #0d0d11;
      --brand-charcoal: #18181b;
      --sidebar-width: 260px;
    }

    body {
      min-height: 100vh;
      background-color: var(--w3-surface-alt);
      color: var(--w3-text-color);
      font-family: var(--w3-font-family);
      margin: 0;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    body.w3-dark-mode {
      background-color: var(--w3-page-bg);
    }

    /* Sidebar Layout */
    .app-sidebar {
      width: var(--sidebar-width);
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      background-color: var(--brand-black);
      color: #ffffff;
      z-index: 20;
      overflow-y: auto;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      transition: transform 0.3s ease;
    }

    .app-main {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: margin-left 0.3s ease;
    }

    @media (max-width: 992px) {
      .app-sidebar {
        transform: translateX(-100%);
      }
      .app-sidebar.open {
        transform: translateX(0);
      }
      .app-main {
        margin-left: 0;
      }
    }

    /* Topbar */
    .app-topbar {
      height: 64px;
      background-color: var(--w3-surface);
      border-bottom: 1px solid var(--w3-border-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 10;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    /* Brand Header in Sidebar */
    .sidebar-brand {
      padding: 20px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-bottom: 2px solid var(--brand-red);
      background-color: #08080a;
    }

    .brand-avatar {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      object-fit: cover;
      border: 1.5px solid var(--brand-red);
      box-shadow: 0 2px 10px var(--brand-red-glow);
    }

    /* Navigation Links */
    .nav-group-title {
      padding: 16px 20px 6px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #71717a;
      font-weight: 700;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 20px;
      color: #a1a1aa;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      border-left: 3px solid transparent;
      transition: all 0.2s ease;
    }

    .nav-item:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.05);
      border-left-color: #71717a;
    }

    .nav-item.active {
      color: #ffffff;
      background-color: rgba(220, 38, 38, 0.12);
      border-left-color: var(--brand-red);
      font-weight: 600;
    }

    .nav-item svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    /* Buttons */
    .btn-brand {
      background-color: var(--brand-red);
      color: #ffffff;
      border: 1px solid var(--brand-red);
      padding: 8px 16px;
      font-weight: 600;
      font-size: 13px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-brand:hover {
      background-color: var(--brand-red-hover);
      border-color: var(--brand-red-hover);
      color: #ffffff;
    }

    .btn-secondary {
      background-color: transparent;
      color: inherit;
      border: 1px solid var(--w3-border-color);
      padding: 8px 14px;
      font-weight: 500;
      font-size: 13px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-secondary:hover {
      background-color: var(--w3-hover-bg);
      color: var(--w3-hover-text);
    }

    /* Comprobante Container */
    .receipt-wrapper {
      max-width: 820px;
      margin: 0 auto;
    }

    .receipt-card {
      background-color: var(--w3-surface);
      border-radius: 12px;
      border: 1px solid var(--w3-border-light);
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .receipt-header {
      padding: 32px 32px 24px;
      border-bottom: 2px dashed var(--w3-border-color);
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 20px;
    }

    .receipt-legal-warning {
      background-color: rgba(245, 158, 11, 0.1);
      border-left: 4px solid #f59e0b;
      color: #b45309;
      padding: 10px 14px;
      border-radius: 0 6px 6px 0;
      font-size: 12px;
      font-weight: 600;
      margin-top: 12px;
    }

    body.w3-dark-mode .receipt-legal-warning {
      color: #fbbf24;
    }

    /* Badges */
    .badge-pill {
      display: inline-block;
      padding: 3px 10px;
      font-size: 11px;
      font-weight: 700;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-red {
      background-color: rgba(220, 38, 38, 0.15);
      color: var(--brand-red);
      border: 1px solid rgba(220, 38, 38, 0.3);
    }

    .badge-gray {
      background-color: rgba(113, 113, 122, 0.15);
      color: #a1a1aa;
      border: 1px solid rgba(113, 113, 122, 0.3);
    }

    .badge-green {
      background-color: rgba(34, 197, 94, 0.15);
      color: #22c55e;
      border: 1px solid rgba(34, 197, 94, 0.3);
    }

    /* Tables */
    .receipt-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .receipt-table th {
      padding: 12px 16px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #71717a;
      font-weight: 700;
      border-bottom: 1px solid var(--w3-border-light);
      background-color: rgba(0, 0, 0, 0.02);
    }

    body.w3-dark-mode .receipt-table th {
      background-color: rgba(255, 255, 255, 0.02);
    }

    .receipt-table td {
      padding: 14px 16px;
      font-size: 13px;
      border-bottom: 1px solid var(--w3-border-light);
      vertical-align: middle;
    }

    .summary-card {
      background-color: rgba(0, 0, 0, 0.02);
      border-radius: 8px;
      padding: 20px;
      border: 1px solid var(--w3-border-light);
    }

    body.w3-dark-mode .summary-card {
      background-color: rgba(255, 255, 255, 0.02);
    }

    /* Print styles */
    @media print {
      body {
        background-color: #ffffff !important;
        color: #000000 !important;
      }
      .app-sidebar, .app-topbar, .no-print {
        display: none !important;
      }
      .app-main {
        margin-left: 0 !important;
      }
      .receipt-card {
        box-shadow: none !important;
        border: 1px solid #ddd !important;
      }
      .receipt-legal-warning {
        border-color: #000 !important;
        color: #333 !important;
      }
    }

    .sidebar-backdrop {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.6);
      z-index: 15;
    }
  </style>
</head>
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>

  <!-- Telón de fondo móvil -->
  <div
    class="sidebar-backdrop no-print"
    x-show="sidebarOpen"
    @click="sidebarOpen = false"
    x-transition:enter="w3-animate-opacity"
    x-transition:leave="w3-animate-opacity"
    style="display: none;"
  ></div>

  <!-- Barra lateral (Sidebar) -->
  <aside class="app-sidebar no-print" :class="{ 'open': sidebarOpen }">
    <div class="sidebar-brand">
      <img
        src="/resources/images/banner.jpg"
        alt="{{ _ENV['APP_NAME'] }}"
        class="brand-avatar"
        onerror="this.style.display='none'"
      >
      <div style="overflow: hidden;">
        <div style="font-weight: 800; font-size: 13px; text-transform: uppercase; color: #ffffff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {{ _ENV['APP_NAME'] }}
        </div>
        <div style="font-size: 11px; color: #a1a1aa; display: flex; align-items: center; gap: 4px; margin-top: 2px;">
          <span style="width: 7px; height: 7px; border-radius: 50%; background-color: #22c55e; display: inline-block;"></span>
          Sistema en línea
        </div>
      </div>
    </div>

    <!-- Navegación principal -->
    <nav style="padding: 8px 0 24px;">
      <div class="nav-group-title">Principal</div>

      <a href="/" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Dashboard</span>
      </a>

      <div class="nav-group-title">Gestión de Negocio</div>

      <a href="/clientes" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span>Clientes</span>
      </a>

      <a href="/proveedores" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <span>Proveedores</span>
      </a>

      <a href="/vendedores" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span>Vendedores</span>
      </a>

      <a href="/cotizaciones" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Tasas de Cambio</span>
      </a>

      <div class="nav-group-title">Módulos de Repuestos</div>

      <a href="/productos" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <span>Catálogo de Productos</span>
      </a>

      <a href="/compras" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <span>Inventario y Lotes</span>
      </a>

      <a href="/ventas" class="nav-item active">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span>Ventas y Facturación</span>
      </a>

      <div class="nav-group-title">Sistema y Seguridad</div>

      <a href="/actualizar-clave" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Actualizar Contraseña</span>
      </a>

      <a href="/salir" class="nav-item" style="color: #ef4444;">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Cerrar Sesión</span>
      </a>
    </nav>
  </aside>

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    <!-- Topbar -->
    <header class="app-topbar no-print">
      <div style="display: flex; align-items: center; gap: 14px;">
        <button
          type="button"
          class="btn-secondary w3-hide-large"
          @click="sidebarOpen = true"
          aria-label="Abrir menú"
        >
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <h1 style="margin: 0; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <span>Comprobante de Venta</span>
          <span class="badge-pill badge-red w3-hide-small">{{ sale.code }}</span>
        </h1>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <button
          type="button"
          class="btn-secondary"
          onclick="window.print()"
          title="Imprimir comprobante"
        >
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span class="w3-hide-small">Imprimir</span>
        </button>

        <button
          type="button"
          class="btn-secondary"
          @click="isDarkMode = !isDarkMode"
          :title="isDarkMode ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'"
          aria-label="Alternar modo de color"
        >
          <svg x-show="isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg x-show="!isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <a href="/salir" class="btn-brand" style="padding: 7px 14px;" title="Cerrar sesión actual">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="w3-hide-small">Salir</span>
        </a>
      </div>
    </header>

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Breadcrumb y acciones superiores -->
      <div class="receipt-wrapper no-print" style="margin-bottom: 20px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/ventas" style="color: inherit; text-decoration: none;">Ventas</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Comprobante #{{ sale.id }}</span>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <a href="/ventas" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Historial de Ventas
          </a>
          <button type="button" class="btn-brand" onclick="window.print()">
            <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Imprimir Comprobante
          </button>
        </div>
      </div>

      <!-- Tarjeta del Comprobante -->
      <div class="receipt-wrapper">
        <div class="receipt-card">
          <!-- Encabezado del Comprobante -->
          <div class="receipt-header">
            <div>
              <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                <img
                  src="/resources/images/banner.jpg"
                  alt="{{ _ENV['APP_NAME'] }}"
                  style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover; border: 1.5px solid var(--brand-red);"
                  onerror="this.style.display='none'"
                >
                <div>
                  <h2 style="margin: 0; font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.2px;">
                    {{ _ENV['APP_NAME'] }}
                  </h2>
                  <div style="font-size: 12px; color: #71717a;">
                    Control de Inventario por Lote &bull; Trazabilidad Comercial
                  </div>
                </div>
              </div>

              <!-- Advertencia Legal Requerida -->
              <div class="receipt-legal-warning">
                NOTA LEGAL: Este documento constituye un <strong>comprobante interno de entrega y control de venta</strong>. NO es una factura fiscal.
              </div>
            </div>

            <!-- Metadatos de la Venta -->
            <div style="text-align: right; min-width: 220px;">
              <span class="badge-pill badge-gray" style="font-size: 14px; font-family: monospace; letter-spacing: 1px;">
                {{ sale.code }}
              </span>
              <div style="font-size: 12px; color: #71717a; margin-top: 8px;">
                Comprobante interno: <strong>#{{ "%04d"|format(sale.id) }}</strong>
              </div>
              <div style="font-size: 12px; color: #71717a; margin-top: 2px;">
                Fecha: <strong>{{ sale.created_at }}</strong>
              </div>
            </div>
          </div>

          <!-- Información del Cliente y Vendedor -->
          <div style="padding: 24px 32px; border-bottom: 1px solid var(--w3-border-light);">
            <div class="w3-row" style="margin: 0 -12px;">
              <div class="w3-col l6 m6 s12" style="padding: 0 12px; margin-bottom: 12px;">
                <div style="font-size: 11px; text-transform: uppercase; color: #71717a; font-weight: 700; letter-spacing: 0.5px;">
                  Cliente / Comprador
                </div>
                <div style="font-size: 16px; font-weight: 800; margin-top: 4px;">
                  {{ sale.client_name }}
                </div>
              </div>

              <div class="w3-col l6 m6 s12" style="padding: 0 12px;">
                <div style="font-size: 11px; text-transform: uppercase; color: #71717a; font-weight: 700; letter-spacing: 0.5px;">
                  Vendedor / Asesor
                </div>
                <div style="font-size: 14px; color: #a1a1aa; margin-top: 4px; font-family: monospace;">
                  {{ sale.seller_email }}
                </div>
              </div>
            </div>

            <!-- Tasa de Cambio Histórica Aplicada -->
            <div style="margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--w3-border-light); font-size: 12px; color: #71717a; display: flex; flex-wrap: wrap; gap: 16px;">
              <div>
                Tasa aplicada: <strong>1 USD = {{ sale.usd_ves|number_format(2, ',', '.') }} Bs</strong>
              </div>
              <div>
                Tasa COP: <strong>1 USD = {{ sale.usd_cop|number_format(2, ',', '.') }} COP</strong>
              </div>
            </div>
          </div>

          <!-- Detalle de Ítems / Repuestos -->
          <div style="overflow-x: auto;">
            <table class="receipt-table">
              <thead>
                <tr>
                  <th style="width: 40px; text-align: center;">#</th>
                  <th>Descripción del Repuesto</th>
                  <th>Lote de Origen</th>
                  <th style="text-align: right;">Cantidad</th>
                  <th style="text-align: right;">Precio Unit. (USD)</th>
                  <th style="text-align: right;">Subtotal USD</th>
                </tr>
              </thead>
              <tbody>
                {% for item in items %}
                  <tr>
                    <td style="text-align: center; color: #71717a; font-family: monospace;">
                      {{ loop.index }}
                    </td>
                    <td>
                      <div style="font-weight: 700;">{{ item.product_name }}</div>
                      <div style="font-size: 11px; color: #71717a;">{{ item.product_category }}</div>
                    </td>
                    <td>
                      <span class="badge-pill badge-gray" style="font-size: 11px;">
                        {{ item.supplier_alias }} &bull; {{ item.supplier_invoice_code }}
                      </span>
                    </td>
                    <td style="text-align: right; font-weight: 700; font-family: monospace;">
                      {{ item.quantity }}
                    </td>
                    <td style="text-align: right; font-family: monospace;">
                      ${{ item.product_price|number_format(2, '.', ',') }}
                    </td>
                    <td style="text-align: right; font-weight: 800; font-family: monospace;">
                      ${{ item.subtotal|number_format(2, '.', ',') }}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          <!-- Bloque de Totales y Pagos -->
          <div style="padding: 24px 32px; border-top: 2px dashed var(--w3-border-color);">
            <div class="w3-row" style="margin: 0 -12px;">
              <!-- Detalle de pagos recibidos -->
              <div class="w3-col l6 m12" style="padding: 0 12px; margin-bottom: 20px;">
                <div style="font-size: 12px; text-transform: uppercase; color: #71717a; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 10px;">
                  Comprobantes de Pago Registrados
                </div>

                {% if payments is empty %}
                  <div style="font-size: 13px; color: #71717a; font-style: italic;">
                    No se registraron abonos ni cobros inmediatos asociados a este comprobante.
                  </div>
                {% else %}
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    {% for p in payments %}
                      <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background-color: rgba(0,0,0,0.02); border-radius: 6px; font-size: 13px;">
                        <div>
                          <span class="badge-pill badge-green" style="font-size: 10px; margin-right: 6px;">
                            {{ p.currency|upper }}
                          </span>
                          {% if p.currency == 'usd' %}
                            ${{ p.amount|number_format(2, '.', ',') }}
                          {% elseif p.currency == 'ves' %}
                            {{ p.amount|number_format(2, ',', '.') }} Bs
                            <span style="font-size: 11px; color: #71717a;">(Tasa: {{ p.usd_ves|number_format(2, ',', '.') }})</span>
                          {% elseif p.currency == 'cop' %}
                            {{ p.amount|number_format(2, ',', '.') }} COP
                            <span style="font-size: 11px; color: #71717a;">(Tasa: {{ p.usd_cop|number_format(2, ',', '.') }})</span>
                          {% endif %}
                        </div>
                        <div style="font-weight: 700; font-family: monospace;">
                          {% if p.currency == 'usd' %}
                            ${{ p.amount|number_format(2, '.', ',') }}
                          {% elseif p.currency == 'ves' %}
                            ${{ (p.amount / p.usd_ves)|number_format(2, '.', ',') }}
                          {% elseif p.currency == 'cop' %}
                            ${{ (p.amount / p.usd_cop)|number_format(2, '.', ',') }}
                          {% endif %}
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>

              <!-- Resumen de liquidación -->
              <div class="w3-col l6 m12" style="padding: 0 12px;">
                <div class="summary-card">
                  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px;">
                    <span style="font-size: 14px; font-weight: 700;">TOTAL DE LA VENTA:</span>
                    <span style="font-size: 22px; font-weight: 800; color: #22c55e;">
                      ${{ totalUSD|number_format(2, '.', ',') }} USD
                    </span>
                  </div>

                  <div style="display: flex; justify-content: space-between; font-size: 13px; color: #71717a; margin-bottom: 4px;">
                    <span>Referencial en Bolívares (VES):</span>
                    <span style="font-family: monospace; font-weight: 600;">{{ totalVES|number_format(2, ',', '.') }} Bs</span>
                  </div>

                  <div style="display: flex; justify-content: space-between; font-size: 13px; color: #71717a; margin-bottom: 12px;">
                    <span>Referencial en Pesos (COP):</span>
                    <span style="font-family: monospace; font-weight: 600;">{{ totalCOP|number_format(2, ',', '.') }} COP</span>
                  </div>

                  <div style="border-top: 1px dashed var(--w3-border-light); padding-top: 10px; display: flex; justify-content: space-between; font-size: 13px;">
                    <span>Total Pagado:</span>
                    <span style="font-weight: 700; font-family: monospace; color: var(--brand-red);">
                      ${{ totalPaidUSD|number_format(2, '.', ',') }} USD
                    </span>
                  </div>

                  <div style="display: flex; justify-content: space-between; font-size: 13px; margin-top: 4px;">
                    <span>Saldo Pendiente:</span>
                    <span style="font-weight: 800; font-family: monospace;">
                      {% set saldo = totalUSD - totalPaidUSD %}
                      {% if saldo <= 0.01 %}
                        <span style="color: #22c55e;">PAGADO TOTAL</span>
                      {% else %}
                        ${{ saldo|number_format(2, '.', ',') }} USD
                      {% endif %}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Pie del comprobante -->
          <div style="padding: 16px 32px; background-color: rgba(0,0,0,0.015); border-top: 1px solid var(--w3-border-light); font-size: 11px; color: #71717a; text-align: center;">
            Comprobante de despacho y entrega de repuestos generado por {{ _ENV['APP_NAME'] }}.
            <br>
            Copia de control interno para el cliente y control de inventario de lotes.
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="no-print" style="padding: 20px 24px; border-top: 1px solid var(--w3-border-light); font-size: 12px; color: #71717a; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <div>
        &copy; 2026 <strong>{{ _ENV['APP_NAME'] }}</strong>. Comprobante de venta.
      </div>
      <div>
        Sistema de inventario por lote y trazabilidad comercial.
      </div>
    </footer>
  </div>

</body>
</html>
