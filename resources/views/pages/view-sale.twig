{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/view-sale.css">
{% endblock %}

{% block title %}Comprobante de Venta {{ sale.code }}{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/ventas'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Comprobante de Venta',
      badge: sale.code,
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Breadcrumb y acciones superiores -->
      <div class="receipt-wrapper no-print" style="margin-bottom: 20px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/ventas" style="color: inherit; text-decoration: none;">Ventas</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Comprobante #{{ sale.id }}</span>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <a href="/ventas" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Historial de Ventas
          </a>
          <button type="button" class="btn-brand" onclick="window.print()">
            <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Imprimir Comprobante
          </button>
        </div>
      </div>

      <!-- Tarjeta del Comprobante -->
      <div class="receipt-wrapper">
        <div class="receipt-card">
          <!-- Encabezado del Comprobante -->
          <div class="receipt-header">
            <div>
              <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                <img
                  src="/resources/images/banner.jpg"
                  alt="{{ _ENV['APP_NAME'] }}"
                  style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover; border: 1.5px solid var(--brand-red);"
                  onerror="this.style.display='none'"
                >
                <div>
                  <h2 style="margin: 0; font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.2px;">
                    {{ _ENV['APP_NAME'] }}
                  </h2>
                  <div style="font-size: 12px; color: #71717a;">
                    Control de Inventario por Lote &bull; Trazabilidad Comercial
                  </div>
                </div>
              </div>

              <!-- Advertencia Legal Requerida -->
              <div class="receipt-legal-warning">
                NOTA LEGAL: Este documento constituye un <strong>comprobante interno de entrega y control de venta</strong>. NO es una factura fiscal.
              </div>
            </div>

            <!-- Metadatos de la Venta -->
            <div style="text-align: right; min-width: 220px;">
              <span class="badge-pill badge-gray" style="font-size: 14px; font-family: monospace; letter-spacing: 1px;">
                {{ sale.code }}
              </span>
              <div style="font-size: 12px; color: #71717a; margin-top: 8px;">
                Comprobante interno: <strong>#{{ "%04d"|format(sale.id) }}</strong>
              </div>
              <div style="font-size: 12px; color: #71717a; margin-top: 2px;">
                Fecha: <strong>{{ sale.created_at }}</strong>
              </div>
            </div>
          </div>

          <!-- Información del Cliente y Vendedor -->
          <div style="padding: 24px 32px; border-bottom: 1px solid var(--w3-border-light);">
            <div class="w3-row" style="margin: 0 -12px;">
              <div class="w3-col l6 m6 s12" style="padding: 0 12px; margin-bottom: 12px;">
                <div style="font-size: 11px; text-transform: uppercase; color: #71717a; font-weight: 700; letter-spacing: 0.5px;">
                  Cliente / Comprador
                </div>
                <div style="font-size: 16px; font-weight: 800; margin-top: 4px;">
                  {{ sale.client_name }}
                </div>
              </div>

              <div class="w3-col l6 m6 s12" style="padding: 0 12px;">
                <div style="font-size: 11px; text-transform: uppercase; color: #71717a; font-weight: 700; letter-spacing: 0.5px;">
                  Vendedor / Asesor
                </div>
                <div style="font-size: 14px; color: #a1a1aa; margin-top: 4px; font-family: monospace;">
                  {{ sale.seller_email }}
                </div>
              </div>
            </div>

            <!-- Tasa de Cambio Histórica Aplicada -->
            <div style="margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--w3-border-light); font-size: 12px; color: #71717a; display: flex; flex-wrap: wrap; gap: 16px;">
              <div>
                Tasa aplicada: <strong>1 USD = {{ sale.usd_ves|number_format(2, ',', '.') }} Bs</strong>
              </div>
              <div>
                Tasa COP: <strong>1 USD = {{ sale.usd_cop|number_format(2, ',', '.') }} COP</strong>
              </div>
            </div>
          </div>

          <!-- Detalle de Ítems / Repuestos -->
          <div style="overflow-x: auto;">
            <table class="receipt-table">
              <thead>
                <tr>
                  <th style="width: 40px; text-align: center;">#</th>
                  <th>Descripción del Repuesto</th>
                  <th>Lote de Origen</th>
                  <th style="text-align: right;">Cantidad</th>
                  <th style="text-align: right;">Precio Unit. (USD)</th>
                  <th style="text-align: right;">Subtotal USD</th>
                </tr>
              </thead>
              <tbody>
                {% for item in items %}
                  <tr>
                    <td style="text-align: center; color: #71717a; font-family: monospace;">
                      {{ loop.index }}
                    </td>
                    <td>
                      <div style="font-weight: 700;">{{ item.product_name }}</div>
                      <div style="font-size: 11px; color: #71717a;">{{ item.product_category }}</div>
                    </td>
                    <td>
                      <span class="badge-pill badge-gray" style="font-size: 11px;">
                        {{ item.supplier_alias }} &bull; {{ item.supplier_invoice_code }}
                      </span>
                    </td>
                    <td style="text-align: right; font-weight: 700; font-family: monospace;">
                      {{ item.quantity }}
                    </td>
                    <td style="text-align: right; font-family: monospace;">
                      ${{ item.product_price|number_format(2, '.', ',') }}
                    </td>
                    <td style="text-align: right; font-weight: 800; font-family: monospace;">
                      ${{ item.subtotal|number_format(2, '.', ',') }}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          <!-- Bloque de Totales y Pagos -->
          <div style="padding: 24px 32px; border-top: 2px dashed var(--w3-border-color);">
            <div class="w3-row" style="margin: 0 -12px;">
              <!-- Detalle de pagos recibidos -->
              <div class="w3-col l6 m12" style="padding: 0 12px; margin-bottom: 20px;">
                <div style="font-size: 12px; text-transform: uppercase; color: #71717a; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 10px;">
                  Comprobantes de Pago Registrados
                </div>

                {% if payments is empty %}
                  <div style="font-size: 13px; color: #71717a; font-style: italic;">
                    No se registraron abonos ni cobros inmediatos asociados a este comprobante.
                  </div>
                {% else %}
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    {% for p in payments %}
                      <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background-color: rgba(0,0,0,0.02); border-radius: 6px; font-size: 13px;">
                        <div>
                          <span class="badge-pill badge-green" style="font-size: 10px; margin-right: 6px;">
                            {{ p.currency|upper }}
                          </span>
                          {% if p.currency == 'usd' %}
                            ${{ p.amount|number_format(2, '.', ',') }}
                          {% elseif p.currency == 'ves' %}
                            {{ p.amount|number_format(2, ',', '.') }} Bs
                            <span style="font-size: 11px; color: #71717a;">(Tasa: {{ p.usd_ves|number_format(2, ',', '.') }})</span>
                          {% elseif p.currency == 'cop' %}
                            {{ p.amount|number_format(2, ',', '.') }} COP
                            <span style="font-size: 11px; color: #71717a;">(Tasa: {{ p.usd_cop|number_format(2, ',', '.') }})</span>
                          {% endif %}
                        </div>
                        <div style="font-weight: 700; font-family: monospace;">
                          {% if p.currency == 'usd' %}
                            ${{ p.amount|number_format(2, '.', ',') }}
                          {% elseif p.currency == 'ves' %}
                            ${{ (p.amount / p.usd_ves)|number_format(2, '.', ',') }}
                          {% elseif p.currency == 'cop' %}
                            ${{ (p.amount / p.usd_cop)|number_format(2, '.', ',') }}
                          {% endif %}
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>

              <!-- Resumen de liquidación -->
              <div class="w3-col l6 m12" style="padding: 0 12px;">
                <div class="summary-card">
                  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px;">
                    <span style="font-size: 14px; font-weight: 700;">TOTAL DE LA VENTA:</span>
                    <span style="font-size: 22px; font-weight: 800; color: #22c55e;">
                      ${{ totalUSD|number_format(2, '.', ',') }} USD
                    </span>
                  </div>

                  <div style="display: flex; justify-content: space-between; font-size: 13px; color: #71717a; margin-bottom: 4px;">
                    <span>Referencial en Bolívares (VES):</span>
                    <span style="font-family: monospace; font-weight: 600;">{{ totalVES|number_format(2, ',', '.') }} Bs</span>
                  </div>

                  <div style="display: flex; justify-content: space-between; font-size: 13px; color: #71717a; margin-bottom: 12px;">
                    <span>Referencial en Pesos (COP):</span>
                    <span style="font-family: monospace; font-weight: 600;">{{ totalCOP|number_format(2, ',', '.') }} COP</span>
                  </div>

                  <div style="border-top: 1px dashed var(--w3-border-light); padding-top: 10px; display: flex; justify-content: space-between; font-size: 13px;">
                    <span>Total Pagado:</span>
                    <span style="font-weight: 700; font-family: monospace; color: var(--brand-red);">
                      ${{ totalPaidUSD|number_format(2, '.', ',') }} USD
                    </span>
                  </div>

                  <div style="display: flex; justify-content: space-between; font-size: 13px; margin-top: 4px;">
                    <span>Saldo Pendiente:</span>
                    <span style="font-weight: 800; font-family: monospace;">
                      {% set saldo = totalUSD - totalPaidUSD %}
                      {% if saldo <= 0.01 %}
                        <span style="color: #22c55e;">PAGADO TOTAL</span>
                      {% else %}
                        ${{ saldo|number_format(2, '.', ',') }} USD
                      {% endif %}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Pie del comprobante -->
          <div style="padding: 16px 32px; background-color: rgba(0,0,0,0.015); border-top: 1px solid var(--w3-border-light); font-size: 11px; color: #71717a; text-align: center;">
            Comprobante de despacho y entrega de repuestos generado por {{ _ENV['APP_NAME'] }}.
            <br>
            Copia de control interno para el cliente y control de inventario de lotes.
          </div>
        </div>
      </div>
    </main>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Comprobante de venta'},
    ) }}
  </div>

</body>
{% endblock %}
