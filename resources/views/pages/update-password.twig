{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/update-password.css">
{% endblock %}

{% block title %}Actualizar Contraseña{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    showOldPassword: false,
    showNewPassword: false,
    submitting: false,
    newPassword: '',
    confirmPassword: '',
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    },
    get hasLength() {
      return this.newPassword.length >= 8;
    },
    get hasUpper() {
      return /[A-Z]/.test(this.newPassword);
    },
    get hasLower() {
      return /[a-z]/.test(this.newPassword);
    },
    get hasNumber() {
      return /[0-9]/.test(this.newPassword);
    },
    get passwordsMatch() {
      if (!this.confirmPassword) return true;
      return this.newPassword === this.confirmPassword;
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/actualizar-clave'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Seguridad de la Cuenta',
      badge: 'Contraseña',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan y encabezado -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Actualizar Contraseña</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <div>
            <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
              Cambiar Contraseña de Acceso
            </h2>
            <p style="margin: 4px 0 0; font-size: 13px; color: #71717a;">
              Mantén segura tu cuenta actualizando periódicamente tus credenciales.
            </p>
          </div>
          <a href="/" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Panel
          </a>
        </div>
      </div>

      <!-- Tarjeta del Formulario -->
      <div style="max-width: 600px; margin: 0 auto;">
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Modificar Clave</span>
            </div>
            <span class="badge-pill badge-red">Seguridad</span>
          </div>

          <div style="padding: 24px;">
            {{ include('components/alert-error.twig', {flash: flash}) }}

            <form
              method="post"
              novalidate
              @submit="if (!passwordsMatch) { $event.preventDefault(); return; } submitting = true;"
            >
              <!-- Contraseña Actual -->
              <div class="form-group">
                <label for="old_password" class="form-label">
                  Contraseña Actual <span style="color: var(--brand-red);">*</span>
                </label>
                <div class="input-password-wrapper">
                  <input
                    :type="showOldPassword ? 'text' : 'password'"
                    id="old_password"
                    name="old_{{ passwordKey }}"
                    class="form-input"
                    style="padding-right: 48px;"
                    required
                    placeholder="Ingresa tu clave actual"
                    autofocus
                  >
                  <button
                    type="button"
                    class="password-toggle-btn"
                    @click="showOldPassword = !showOldPassword"
                    :title="showOldPassword ? 'Ocultar contraseña' : 'Ver contraseña'"
                    aria-label="Alternar visibilidad"
                  >
                    <svg x-show="!showOldPassword" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <svg x-show="showOldPassword" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Nueva Contraseña -->
              <div class="form-group">
                <label for="new_password" class="form-label">
                  Nueva Contraseña <span style="color: var(--brand-red);">*</span>
                </label>
                <div class="input-password-wrapper">
                  <input
                    :type="showNewPassword ? 'text' : 'password'"
                    id="new_password"
                    name="new_{{ passwordKey }}"
                    x-model="newPassword"
                    class="form-input"
                    style="padding-right: 48px;"
                    required
                    placeholder="Mínimo 8 caracteres"
                  >
                  <button
                    type="button"
                    class="password-toggle-btn"
                    @click="showNewPassword = !showNewPassword"
                    :title="showNewPassword ? 'Ocultar contraseña' : 'Ver contraseña'"
                    aria-label="Alternar visibilidad"
                  >
                    <svg x-show="!showNewPassword" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <svg x-show="showNewPassword" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                    </svg>
                  </button>
                </div>

                <!-- Criterios de fortaleza en vivo -->
                <div style="margin-top: 10px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                  <div class="criteria-item" :class="{ 'met': hasLength }">
                    <span x-text="hasLength ? '✓' : '•'"></span> Mínimo 8 caracteres
                  </div>
                  <div class="criteria-item" :class="{ 'met': hasUpper }">
                    <span x-text="hasUpper ? '✓' : '•'"></span> Una mayúscula
                  </div>
                  <div class="criteria-item" :class="{ 'met': hasLower }">
                    <span x-text="hasLower ? '✓' : '•'"></span> Una minúscula
                  </div>
                  <div class="criteria-item" :class="{ 'met': hasNumber }">
                    <span x-text="hasNumber ? '✓' : '•'"></span> Un número
                  </div>
                </div>
              </div>

              <!-- Confirmación de Nueva Contraseña (Validación cliente) -->
              <div class="form-group">
                <label for="confirm_password" class="form-label">
                  Confirmar Nueva Contraseña <span style="color: var(--brand-red);">*</span>
                </label>
                <input
                  :type="showNewPassword ? 'text' : 'password'"
                  id="confirm_password"
                  x-model="confirmPassword"
                  class="form-input"
                  required
                  placeholder="Repite la nueva contraseña"
                >
                <div
                  x-show="confirmPassword && !passwordsMatch"
                  style="font-size: 12px; color: #ef4444; margin-top: 6px; font-weight: 600;"
                >
                  Las contraseñas no coinciden.
                </div>
              </div>

              <!-- Botones de Acción -->
              <div style="margin-top: 28px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--w3-border-light); padding-top: 20px;">
                <a href="/" class="btn-secondary">
                  Cancelar
                </a>
                <button
                  type="submit"
                  class="btn-brand"
                  :disabled="submitting || !passwordsMatch"
                >
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <span x-text="submitting ? 'Actualizando...' : 'Actualizar Contraseña'"></span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Seguridad y contraseñas'},
    ) }}
  </div>

</body>
{% endblock %}
