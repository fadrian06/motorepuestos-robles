{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/update-exchange-rates.css">
{% endblock %}

{% block title %}Tasas de Cambio y Cotizaciones{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    submitting: false,
    rateVes: {{ (exchangeRate and exchangeRate['usd_ves']) ? exchangeRate['usd_ves'] : '0' }},
    rateCop: {{ (exchangeRate and exchangeRate['usd_cop']) ? exchangeRate['usd_cop'] : '0' }},
    testUsd: 10,
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    },
    formatNumber(num) {
      if (isNaN(num) || num === null || num === undefined) return '0,00';
      return Number(num).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/cotizaciones'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Cotizaciones y Divisas',
      badge: 'Multidivisa',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan y encabezado -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Cotizaciones y Tasas de Cambio</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <div>
            <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
              Configuración de Tasas Oficiales
            </h2>
            <p style="margin: 4px 0 0; font-size: 13px; color: #71717a;">
              Gestiona el valor de conversión en Bolívares (VES) y Pesos (COP) para la facturación, punto de venta y presupuestos de repuestos.
            </p>
          </div>
          {% if exchangeRate %}
            <div class="badge-pill badge-green" title="Registro ID #{{ exchangeRate['id'] }}">
              <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #22c55e;"></span>
              <span>Tasa Activa #{{ exchangeRate['id'] }}</span>
            </div>
          {% else %}
            <div class="badge-pill badge-gray">
              <span>Sin registros previos</span>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Tarjetas de Tasas Vigentes (KPIs) -->
      <div class="kpi-grid">
        <!-- USD / VES -->
        <div class="kpi-card">
          <div>
            <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #71717a; letter-spacing: 0.5px;">
              Tasa USD &rarr; VES (Bolívares)
            </div>
            <div style="font-size: 26px; font-weight: 800; margin: 6px 0 2px; color: var(--w3-text-color);">
              {% if exchangeRate and exchangeRate['usd_ves'] %}
                Bs. {{ exchangeRate['usd_ves']|number_format(2, ',', '.') }}
              {% else %}
                <span style="color: #a1a1aa; font-size: 20px;">No configurada</span>
              {% endif %}
            </div>
            <div style="font-size: 12px; color: #71717a;">
              1 USD = <strong style="color: var(--brand-red);">{{ exchangeRate ? exchangeRate['usd_ves'] : '0.00' }}</strong> VES
            </div>
          </div>
          <div class="kpi-icon-box red" title="Bolívares Venezolanos">
            <span style="font-size: 16px; font-weight: 800;">VES</span>
          </div>
        </div>

        <!-- USD / COP -->
        <div class="kpi-card">
          <div>
            <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #71717a; letter-spacing: 0.5px;">
              Tasa USD &rarr; COP (Pesos Colombianos)
            </div>
            <div style="font-size: 26px; font-weight: 800; margin: 6px 0 2px; color: var(--w3-text-color);">
              {% if exchangeRate and exchangeRate['usd_cop'] %}
                $ {{ exchangeRate['usd_cop']|number_format(2, ',', '.') }}
              {% else %}
                <span style="color: #a1a1aa; font-size: 20px;">No configurada</span>
              {% endif %}
            </div>
            <div style="font-size: 12px; color: #71717a;">
              1 USD = <strong style="color: #3b82f6;">{{ exchangeRate ? exchangeRate['usd_cop'] : '0.00' }}</strong> COP
            </div>
          </div>
          <div class="kpi-icon-box blue" title="Pesos Colombianos">
            <span style="font-size: 16px; font-weight: 800;">COP</span>
          </div>
        </div>

        <!-- Estado y Fecha de Vigencia -->
        <div class="kpi-card">
          <div>
            <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #71717a; letter-spacing: 0.5px;">
              Última Modificación
            </div>
            <div style="font-size: 15px; font-weight: 700; margin: 8px 0 4px; color: var(--w3-text-color);">
              {% if exchangeRate and exchangeRate['created_at'] %}
                {{ exchangeRate['created_at'] }}
              {% else %}
                Sin actualizaciones
              {% endif %}
            </div>
            <div style="font-size: 12px; color: #71717a; display: flex; align-items: center; gap: 5px;">
              <span style="width: 7px; height: 7px; border-radius: 50%; background-color: #22c55e;"></span>
              <span>Aplica a ventas y presupuestos</span>
            </div>
          </div>
          <div class="kpi-icon-box green">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Diseño Principal: Formulario + Simulador en tiempo real -->
      <div class="content-layout">
        <!-- Columna Izquierda: Formulario de Actualización -->
        <div>
          <div class="panel-card">
            <div class="panel-header">
              <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
                <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
                <span>Fijar Nuevas Tasas de Cambio</span>
              </div>
              <span class="badge-pill badge-red">Formulario Oficial</span>
            </div>

            <div style="padding: 24px;">
              {{ include('components/alert-error.twig', {
                flash: flash,
                title: 'Atención al guardar la cotización',
              }) }}

              <form
                method="post"
                novalidate
                @submit="submitting = true"
              >
                <!-- Campo USD -> VES -->
                <div class="form-group">
                  <label for="usd_ves" class="form-label">
                    Tasa USD &rarr; VES (Bolívares) <span style="color: var(--brand-red);">*</span>
                  </label>
                  <div class="input-wrapper">
                    <span class="input-prefix">Bs.</span>
                    <input
                      type="number"
                      step="any"
                      min="0.0001"
                      id="usd_ves"
                      name="usd_ves"
                      value="{{ exchangeRate ? exchangeRate['usd_ves'] : '' }}"
                      class="form-input"
                      x-model.number="rateVes"
                      required
                      placeholder="Ej. 36.50"
                      autofocus
                    >
                  </div>
                  <div class="form-hint">
                    Indica el tipo de cambio oficial (ej. Banco Central de Venezuela) para calcular los precios de venta en Bolívares.
                  </div>
                </div>

                <!-- Campo USD -> COP -->
                <div class="form-group">
                  <label for="usd_cop" class="form-label">
                    Tasa USD &rarr; COP (Pesos Colombianos) <span style="color: var(--brand-red);">*</span>
                  </label>
                  <div class="input-wrapper">
                    <span class="input-prefix">$ COP</span>
                    <input
                      type="number"
                      step="any"
                      min="0.01"
                      id="usd_cop"
                      name="usd_cop"
                      value="{{ exchangeRate ? exchangeRate['usd_cop'] : '' }}"
                      class="form-input"
                      x-model.number="rateCop"
                      required
                      placeholder="Ej. 4150.00"
                    >
                  </div>
                  <div class="form-hint">
                    Tasa de referencia para operaciones comerciales y ventas transfronterizas en Pesos Colombianos.
                  </div>
                </div>

                <!-- Nota informativa -->
                <div class="callout-box">
                  <div style="font-weight: 700; margin-bottom: 2px;">Trazabilidad e Historial Inmutable:</div>
                  Al guardar, se registrará un nuevo punto de cambio con fecha y hora. Las ventas y presupuestos cerrados anteriormente mantendrán su tasa histórica sin alterarse.
                </div>

                <!-- Acciones del Formulario -->
                <div style="margin-top: 28px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--w3-border-light); padding-top: 20px;">
                  <a href="/" class="btn-secondary">
                    Cancelar
                  </a>
                  <button
                    type="submit"
                    class="btn-brand"
                    :disabled="submitting || !rateVes || !rateCop"
                  >
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                    </svg>
                    <span x-text="submitting ? 'Guardando...' : 'Actualizar Tasas'"></span>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Calculadora Simulador en Vivo -->
        <div>
          <!-- Simulador Interactivo -->
          <div class="panel-card">
            <div class="panel-header">
              <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--brand-red);">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                <span>Simulador de Cotización Rápida</span>
              </div>
              <span class="badge-pill badge-blue">En Vivo</span>
            </div>

            <div style="padding: 22px;">
              <p style="margin: 0 0 16px; font-size: 13px; color: #71717a;">
                Prueba cómo se calcularán los precios al mostrador utilizando los valores introducidos en el formulario:
              </p>

              <!-- Monto Base en USD -->
              <div class="form-group" style="margin-bottom: 16px;">
                <label for="calc_usd" class="form-label" style="font-size: 12px;">
                  Precio de Prueba en Repuesto (USD $)
                </label>
                <div class="input-wrapper">
                  <span class="input-prefix">$ USD</span>
                  <input
                    type="number"
                    step="any"
                    id="calc_usd"
                    class="form-input"
                    x-model.number="testUsd"
                    min="0"
                    placeholder="10.00"
                  >
                </div>
              </div>

              <!-- Atajos de montos -->
              <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px;">
                <button type="button" class="calc-chip" @click="testUsd = 5">$5 USD</button>
                <button type="button" class="calc-chip" @click="testUsd = 10">$10 USD</button>
                <button type="button" class="calc-chip" @click="testUsd = 25">$25 USD</button>
                <button type="button" class="calc-chip" @click="testUsd = 50">$50 USD</button>
                <button type="button" class="calc-chip" @click="testUsd = 100">$100 USD</button>
              </div>

              <!-- Resultados Simulados -->
              <div class="calc-result-box">
                <div>
                  <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #71717a;">
                    En Bolívares (VES)
                  </div>
                  <div style="font-size: 20px; font-weight: 800; color: var(--brand-red); margin-top: 2px;">
                    Bs. <span x-text="formatNumber(testUsd * (rateVes || 0))"></span>
                  </div>
                </div>
                <div class="badge-pill badge-red">
                  VES
                </div>
              </div>

              <div class="calc-result-box">
                <div>
                  <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #71717a;">
                    En Pesos Colombianos (COP)
                  </div>
                  <div style="font-size: 20px; font-weight: 800; color: #3b82f6; margin-top: 2px;">
                    $ <span x-text="formatNumber(testUsd * (rateCop || 0))"></span> COP
                  </div>
                </div>
                <div class="badge-pill badge-blue">
                  COP
                </div>
              </div>
            </div>
          </div>

          <!-- Tarjeta de Políticas y Consejos Comerciales -->
          <div class="panel-card">
            <div class="panel-header">
              <div style="font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: #22c55e;">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Directrices del Negocio</span>
              </div>
            </div>

            <div style="padding: 18px; font-size: 13px; line-height: 1.6; color: #71717a;">
              <ul style="margin: 0; padding-left: 20px;">
                <li style="margin-bottom: 8px;">
                  <strong>Moneda Base USD:</strong> Todos los repuestos y lotes registran su costo base en dólares americanos para proteger márgenes de ganancia.
                </li>
                <li style="margin-bottom: 8px;">
                  <strong>Actualización Diaria:</strong> Se recomienda fijar la tasa al inicio de cada jornada laboral antes de aperturar el punto de venta (POS).
                </li>
                <li>
                  <strong>Pagos Mixtos:</strong> El cliente puede cancelar en divisas en efectivo, pago móvil en Bolívares o transferencias en Pesos según estas tasas.
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </main>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Módulo de cotizaciones y tasas'},
    ) }}
  </div>

</body>
{% endblock %}
