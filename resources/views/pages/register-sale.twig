{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/register-sale.css">
{% endblock %}

{% block title %}Registrar Venta{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    submitting: false,
    latestRate: {% if latestExchangeRate %}{ id: {{ latestExchangeRate.id }}, usd_ves: {{ latestExchangeRate.usd_ves }}, usd_cop: {{ latestExchangeRate.usd_cop }} }{% else %}null{% endif %},
    clientsList: [
      {% for c in clients %}
      { id: {{ c.id }}, name: '{{ c.name|e('js') }}' }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    batchesList: [
      {% for b in availableBatches %}
      {
        purchase_item_id: {{ b.purchase_item_id }},
        product_id: {{ b.product_id }},
        product_name: '{{ b.product_name|e('js') }}',
        product_category: '{{ b.product_category|e('js') }}',
        default_price: {{ b.default_price }},
        cost: {{ b.cost }},
        supplier_alias: '{{ b.supplier_alias|e('js') }}',
        supplier_invoice_code: '{{ b.supplier_invoice_code|e('js') }}',
        available_quantity: {{ b.available_quantity }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    items: [
      { purchase_item_id: '', quantity: '1', product_price: '' }
    ],
    payments: [
      { amount: '', currency: 'usd' }
    ],
    addItem() {
      this.items.push({ purchase_item_id: '', quantity: '1', product_price: '' });
    },
    removeItem(index) {
      if (this.items.length > 1) {
        this.items.splice(index, 1);
      }
    },
    addPayment() {
      this.payments.push({ amount: '', currency: 'usd' });
    },
    removePayment(index) {
      this.payments.splice(index, 1);
    },
    onBatchChange(item) {
      const b = this.batchesList.find(x => x.purchase_item_id == item.purchase_item_id);
      if (b && (!item.product_price || item.product_price === '')) {
        item.product_price = b.default_price;
      }
    },
    getBatch(id) {
      return this.batchesList.find(x => x.purchase_item_id == id) || null;
    },
    get totalUSD() {
      return this.items.reduce((sum, it) => {
        const q = parseFloat(it.quantity) || 0;
        const p = parseFloat(it.product_price) || 0;
        return sum + (q * p);
      }, 0);
    },
    get totalVES() {
      if (!this.latestRate) return 0;
      return this.totalUSD * this.latestRate.usd_ves;
    },
    get totalCOP() {
      if (!this.latestRate) return 0;
      return this.totalUSD * this.latestRate.usd_cop;
    },
    get totalPaidUSD() {
      if (!this.latestRate) return 0;
      return this.payments.reduce((sum, pm) => {
        const a = parseFloat(pm.amount) || 0;
        if (pm.currency === 'usd') return sum + a;
        if (pm.currency === 'ves') return sum + (this.latestRate.usd_ves > 0 ? (a / this.latestRate.usd_ves) : 0);
        if (pm.currency === 'cop') return sum + (this.latestRate.usd_cop > 0 ? (a / this.latestRate.usd_cop) : 0);
        return sum;
      }, 0);
    },
    formatUSD(v) {
      return '$' + (Number(v) || 0).toFixed(2);
    },
    formatVES(v) {
      return (Number(v) || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Bs';
    },
    formatCOP(v) {
      return (Number(v) || 0).toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' COP';
    },
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/ventas'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Registrar Venta',
      badge: 'Facturación',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan y encabezado -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/ventas" style="color: inherit; text-decoration: none;">Ventas</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Nueva Venta</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Registrar Nueva Venta
          </h2>
          <a href="/ventas" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Historial
          </a>
        </div>
      </div>

      <!-- Notificación de tasa no configurada -->
      {% if not latestExchangeRate %}
        <div class="alert-warning">
          <div style="font-weight: 700; margin-bottom: 4px;">Atención: Cotización requerida</div>
          <div>
            No existe ninguna tasa de cambio registrada en el sistema. Debes <a href="/cotizaciones" style="color: inherit; font-weight: 700; text-decoration: underline;">configurar las tasas del día</a> antes de emitir ventas.
          </div>
        </div>
      {% endif %}

      <form
        method="post"
        novalidate
        @submit="submitting = true"
        style="max-width: 920px; margin: 0 auto;"
      >

        <!-- ── Sección 1: Datos de la Venta ───────────────────────────────── -->
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Datos Principales del Comprobante</span>
            </div>
            <span class="badge-pill badge-red">Requerido</span>
          </div>

          <div style="padding: 24px;">
            <!-- Notificación de Errores Flash -->
            {% if flash %}
              <div class="alert-error">
                <div style="font-weight: 700; margin-bottom: 4px;">Atención:</div>
                {% for key, error in flash %}
                  <div>&bull; {{ error is iterable ? error|join(', ') : error }}</div>
                {% endfor %}
              </div>
            {% endif %}

            <div class="w3-row-padding" style="margin: 0 -8px;">
              <!-- Código de Factura/Venta -->
              <div class="w3-col l6 m12" style="padding: 0 8px;">
                <div class="form-group">
                  <label for="code" class="form-label">
                    Código de Venta / Factura <span style="color: var(--brand-red);">*</span>
                  </label>
                  <input
                    type="text"
                    id="code"
                    name="code"
                    class="form-input"
                    required
                    placeholder="Ej: VEN-2026-0001"
                    autofocus
                  >
                  <div class="form-hint">Código único de control de la venta.</div>
                </div>
              </div>

              <!-- Cliente -->
              <div class="w3-col l6 m12" style="padding: 0 8px;">
                <div class="form-group">
                  <label for="client_id" class="form-label">
                    Cliente <span style="color: var(--brand-red);">*</span>
                  </label>
                  <select
                    id="client_id"
                    name="client_id"
                    class="form-input"
                    required
                  >
                    <option value="" disabled selected>Seleccionar cliente…</option>
                    {% for c in clients %}
                      <option value="{{ c.id }}">{{ c.name }}</option>
                    {% endfor %}
                  </select>
                  <div class="form-hint">Comprador registrado. Si es nuevo, regístralo antes en <a href="/clientes/registrar" style="color: inherit; text-decoration: underline;">Clientes</a>.</div>
                </div>
              </div>
            </div>

            <!-- Tasa de cambio aplicada informativa -->
            {% if latestExchangeRate %}
              <div class="summary-box" style="margin-top: 8px;">
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: 13px;">
                  <div>
                    <span style="font-weight: 700;">Tasa de Cambio Vigente:</span>
                    <span style="color: #71717a; margin-left: 6px;">(Cotización #{{ latestExchangeRate.id }} del {{ latestExchangeRate.created_at }})</span>
                  </div>
                  <div style="display: flex; gap: 14px; font-family: monospace; font-weight: 600;">
                    <span style="color: #22c55e;">1 USD = {{ latestExchangeRate.usd_ves|number_format(2, ',', '.') }} Bs</span>
                    <span style="color: #3b82f6;">1 USD = {{ latestExchangeRate.usd_cop|number_format(2, ',', '.') }} COP</span>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        <!-- ── Sección 2: Selección de Repuestos e Inventario por Lote ──────── -->
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Repuestos y Control de Lote</span>
            </div>
            <button
              type="button"
              class="btn-brand"
              style="padding: 8px 14px; font-size: 13px;"
              @click="addItem()"
            >
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Agregar Ítem
            </button>
          </div>

          <div style="padding: 0 24px 24px;">
            {% if availableBatches is empty %}
              <div style="padding: 32px 16px; text-align: center; color: #71717a;">
                <p style="margin: 0 0 6px; font-weight: 700;">No hay stock disponible en lotes verificados</p>
                <p style="margin: 0; font-size: 13px;">
                  Para vender repuestos es necesario ingresar compras y <a href="/compras" style="color: inherit; text-decoration: underline; font-weight: 600;">verificarlas</a> previamente.
                </p>
              </div>
            {% else %}
              <div style="overflow-x: auto; margin-top: 16px;">
                <table class="items-table">
                  <thead>
                    <tr>
                      <th style="width: 44%;">Lote / Repuesto (Disponible)</th>
                      <th style="width: 18%;">Cantidad</th>
                      <th style="width: 20%;">Precio Unit. (USD)</th>
                      <th style="width: 18%; text-align: right;">Subtotal</th>
                      <th style="width: 50px; text-align: center;"></th>
                    </tr>
                  </thead>
                  <tbody>
                    <template x-for="(item, index) in items" :key="index">
                      <tr>
                        <!-- Lote / Producto -->
                        <td>
                          <select
                            :name="'purchase_item_id[]'"
                            x-model="item.purchase_item_id"
                            @change="onBatchChange(item)"
                            class="item-input"
                            required
                          >
                            <option value="" disabled selected>Seleccionar repuesto por lote…</option>
                            <template x-for="b in batchesList" :key="b.purchase_item_id">
                              <option
                                :value="b.purchase_item_id"
                                x-text="b.product_name + ' [Disp: ' + b.available_quantity + '] (Lote: ' + b.supplier_alias + ' ' + b.supplier_invoice_code + ')'"
                              ></option>
                            </template>
                          </select>
                          <template x-if="getBatch(item.purchase_item_id)">
                            <div style="font-size: 11px; color: #71717a; margin-top: 4px;">
                              Categoría: <span x-text="getBatch(item.purchase_item_id).product_category"></span> |
                              Costo lote: <span x-text="formatUSD(getBatch(item.purchase_item_id).cost)"></span>
                            </div>
                          </template>
                        </td>

                        <!-- Cantidad -->
                        <td>
                          <input
                            type="number"
                            :name="'quantity[]'"
                            x-model="item.quantity"
                            class="item-input"
                            min="0.01"
                            step="0.01"
                            :max="getBatch(item.purchase_item_id) ? getBatch(item.purchase_item_id).available_quantity : null"
                            placeholder="0.00"
                            required
                          >
                        </td>

                        <!-- Precio Unitario en USD -->
                        <td>
                          <input
                            type="number"
                            :name="'product_price[]'"
                            x-model="item.product_price"
                            class="item-input"
                            min="0.01"
                            step="0.01"
                            placeholder="0.00"
                            required
                          >
                        </td>

                        <!-- Subtotal Calculado -->
                        <td style="text-align: right; font-weight: 700; font-family: monospace; font-size: 13px;" x-text="formatUSD((parseFloat(item.quantity) || 0) * (parseFloat(item.product_price) || 0))">
                        </td>

                        <!-- Quitar -->
                        <td style="text-align: center;">
                          <button
                            type="button"
                            class="btn-danger-outline"
                            style="padding: 6px 8px;"
                            @click="removeItem(index)"
                            :disabled="items.length === 1"
                            title="Quitar este ítem"
                          >
                            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        </td>
                      </tr>
                    </template>
                  </tbody>
                </table>
              </div>
            {% endif %}

            <!-- Totales de la Venta -->
            <div style="margin-top: 20px; display: flex; justify-content: flex-end;">
              <div class="summary-box" style="min-width: 280px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 14px;">
                  <span style="color: #71717a;">Total en Dólares:</span>
                  <span style="font-weight: 800; font-size: 16px; color: #22c55e;" x-text="formatUSD(totalUSD)"></span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 12px; color: #71717a;">
                  <span>Ref. Bolívares:</span>
                  <span style="font-family: monospace;" x-text="formatVES(totalVES)"></span>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 12px; color: #71717a;">
                  <span>Ref. Pesos COP:</span>
                  <span style="font-family: monospace;" x-text="formatCOP(totalCOP)"></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ── Sección 3: Métodos de Pago (Opcional / Cobro) ────────────────── -->
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Cobro y Pagos Recibidos</span>
            </div>
            <button
              type="button"
              class="btn-secondary"
              style="padding: 7px 12px; font-size: 12px;"
              @click="addPayment()"
            >
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Agregar Pago
            </button>
          </div>

          <div style="padding: 0 24px 24px;">
            <p style="font-size: 13px; color: #71717a; margin: 16px 0 12px;">
              Puedes registrar abonos o pagos inmediatos en dólares (USD), bolívares (VES) o pesos colombianos (COP).
            </p>

            <div style="overflow-x: auto;">
              <table class="items-table">
                <thead>
                  <tr>
                    <th style="width: 40%;">Monto Recibido</th>
                    <th style="width: 35%;">Moneda</th>
                    <th style="width: 15%; text-align: right;">Equiv. USD</th>
                    <th style="width: 50px; text-align: center;"></th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="(pm, pIndex) in payments" :key="pIndex">
                    <tr>
                      <td>
                        <input
                          type="number"
                          :name="'payment_amount[]'"
                          x-model="pm.amount"
                          class="item-input"
                          min="0.01"
                          step="0.01"
                          placeholder="Monto pagado"
                        >
                      </td>
                      <td>
                        <select
                          :name="'payment_currency[]'"
                          x-model="pm.currency"
                          class="item-input"
                        >
                          <option value="usd">Dólares Estadounidenses (USD)</option>
                          <option value="ves">Bolívares (VES)</option>
                          <option value="cop">Pesos Colombianos (COP)</option>
                        </select>
                      </td>
                      <td style="text-align: right; font-family: monospace; font-size: 13px; font-weight: 600;">
                        <span x-text="pm.currency === 'usd' ? formatUSD(pm.amount) : (pm.currency === 'ves' && latestRate ? formatUSD(pm.amount / latestRate.usd_ves) : (pm.currency === 'cop' && latestRate ? formatUSD(pm.amount / latestRate.usd_cop) : '$0.00'))"></span>
                      </td>
                      <td style="text-align: center;">
                        <button
                          type="button"
                          class="btn-danger-outline"
                          style="padding: 6px 8px;"
                          @click="removePayment(pIndex)"
                          title="Eliminar este pago"
                        >
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>

            <div style="margin-top: 14px; display: flex; justify-content: flex-end;">
              <div style="font-size: 13px; color: #71717a;">
                Total Pagado: <strong style="color: var(--brand-red);" x-text="formatUSD(totalPaidUSD)"></strong>
                &bull; Saldo pendiente: <strong x-text="formatUSD(Math.max(0, totalUSD - totalPaidUSD))"></strong>
              </div>
            </div>
          </div>
        </div>

        <!-- ── Botones de acción ─────────────────────────────────────────── -->
        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 12px; padding-bottom: 24px;">
          <a href="/ventas" class="btn-secondary">
            Cancelar
          </a>
          <button
            type="submit"
            class="btn-brand"
            :disabled="submitting || !latestRate || batchesList.length === 0"
          >
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span x-text="submitting ? 'Procesando Venta...' : 'Completar y Registrar Venta'"></span>
          </button>
        </div>

      </form>
    </main>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Emisión y registro de facturas de venta'},
    ) }}
  </div>

</body>
{% endblock %}
