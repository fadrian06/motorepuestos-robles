{% extends "components/layout-login.twig" %}

{% block content %}
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Página no encontrada - {{ _ENV['APP_NAME'] }}</title>
  <link rel="icon" type="image/jpeg" href="/resources/images/favicon.jpg">
  <link rel="stylesheet" href="/resources/styles/w3.css">
  <script defer src="/resources/scripts/alpinejs/dist/cdn.min.js"></script>
  <style>
    :root {
      --brand-red: #dc2626;
      --brand-red-hover: #b91c1c;
      --brand-red-glow: rgba(220, 38, 38, 0.35);
      --brand-black: #0d0d11;
      --brand-gray-dark: #18181b;
      --brand-gray-light: #f4f4f5;
    }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-image: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), url('/resources/images/background.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
      background-color: var(--brand-black);
      color: var(--w3-text-color);
      padding: 16px;
      transition: background 0.3s ease, color 0.3s ease;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    body.w3-dark-mode {
      background-image: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.85)), url('/resources/images/background.jpg');
    }
    .error-card {
      width: 100%;
      max-width: 500px;
      border-radius: 20px;
      background-color: var(--w3-surface);
      color: var(--w3-text-color);
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      animation: fadeInUp 0.6s ease-out;
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .error-header {
      background-color: var(--brand-black);
      padding: 40px 20px;
      border-bottom: 4px solid var(--brand-red);
    }
    .error-code {
      font-size: 80px;
      font-weight: 900;
      color: var(--brand-red);
      line-height: 1;
      margin: 0;
      text-shadow: 0 0 20px var(--brand-red-glow);
    }
    .error-content {
      padding: 40px 30px;
    }
    .error-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 12px;
      color: var(--w3-text-color);
    }
    .error-text {
      font-size: 16px;
      color: #a1a1aa;
      margin-bottom: 32px;
      line-height: 1.6;
    }
    .btn-home {
      background-color: var(--brand-red);
      color: #ffffff;
      text-decoration: none;
      padding: 12px 24px;
      font-weight: 700;
      text-transform: uppercase;
      font-size: 14px;
      border-radius: 10px;
      display: inline-block;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px var(--brand-red-glow);
    }
    .btn-home:hover {
      background-color: var(--brand-red-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(220, 38, 38, 0.4);
    }
    .theme-toggle-btn {
      position: absolute;
      top: 20px;
      right: 20px;
      background: rgba(255, 255, 255, 0.1);
      border: none;
      color: #9ca3af;
      cursor: pointer;
      padding: 8px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      backdrop-filter: blur(4px);
    }
    .theme-toggle-btn:hover {
      color: var(--brand-red);
      background-color: rgba(255, 255, 255, 0.2);
    }
  </style>
</head>
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>

  <button
    type="button"
    class="theme-toggle-btn"
    @click="isDarkMode = !isDarkMode"
    aria-label="Alternar modo oscuro"
  >
    <svg x-show="isDarkMode" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <svg x-show="!isDarkMode" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
  </button>

  <main class="error-card w3-animate-opacity">
    <header class="error-header w3-center">
      <h1 class="error-code">404</h1>
    </header>
    
    <div class="error-content w3-center">
      <h2 class="error-title">¡Ups! Página no encontrada</h2>
      <p class="error-text">
        Lo sentimos, la página que estás buscando no existe o ha sido movida a otra ubicación.
      </p>
      <a href="/" class="btn-home">
        Volver al Inicio
      </a>
    </div>
  </main>

</body>
{% endblock %}
