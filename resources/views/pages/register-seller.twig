{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/register-seller.css">
{% endblock %}

{% block title %}Registrar Vendedor{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    showPassword: false,
    submitting: false,
    password: '',
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/vendedores'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Registrar Vendedor',
      badge: 'Usuario',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan y encabezado -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/vendedores" style="color: inherit; text-decoration: none;">Vendedores</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Nuevo Registro</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Crear Cuenta de Vendedor
          </h2>
          <a href="/vendedores" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Equipo
          </a>
        </div>
      </div>

      <!-- Tarjeta del Formulario -->
      <div style="max-width: 640px; margin: 0 auto;">
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Credenciales del Vendedor</span>
            </div>
            <span class="badge-pill badge-red">Rol: Vendedor</span>
          </div>

          <div style="padding: 24px;">
            <!-- Notificación de Errores Flash -->
            {% if flash %}
              <div class="alert-error">
                <div style="font-weight: 700; margin-bottom: 4px;">Atención:</div>
                {% for key, error in flash %}
                  <div>&bull; {{ error is iterable ? error|join(', ') : error }}</div>
                {% endfor %}
              </div>
            {% endif %}

            <form
              method="post"
              novalidate
              @submit="submitting = true"
            >
              <!-- Correo electrónico -->
              <div class="form-group">
                <label for="seller_email" class="form-label">
                  Correo Electrónico <span style="color: var(--brand-red);">*</span>
                </label>
                <input
                  type="email"
                  id="seller_email"
                  name="email"
                  class="form-input"
                  required
                  placeholder="ejemplo@motorepuestos.com"
                  autofocus
                >
                <div class="form-hint">
                  El correo será utilizado para el inicio de sesión y para la recepción de enlaces de verificación.
                </div>
              </div>

              <!-- Contraseña -->
              <div class="form-group">
                <label for="seller_password" class="form-label">
                  Contraseña de Acceso <span style="color: var(--brand-red);">*</span>
                </label>
                <div class="input-password-wrapper">
                  <input
                    :type="showPassword ? 'text' : 'password'"
                    id="seller_password"
                    name="{{ passwordKey }}"
                    x-model="password"
                    class="form-input"
                    style="padding-right: 48px;"
                    required
                    placeholder="Contraseña inicial para el vendedor"
                  >
                  <button
                    type="button"
                    class="password-toggle-btn"
                    @click="showPassword = !showPassword"
                    :title="showPassword ? 'Ocultar contraseña' : 'Ver contraseña'"
                    aria-label="Alternar visibilidad de contraseña"
                  >
                    <svg x-show="!showPassword" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <svg x-show="showPassword" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                    </svg>
                  </button>
                </div>
                <div class="form-hint">
                  Una vez registrada la cuenta, podrás asignarle permisos individuales desde el botón "Permisos" en el listado de vendedores.
                </div>
              </div>

              <div style="margin-top: 28px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--w3-border-light); padding-top: 20px;">
                <a href="/vendedores" class="btn-secondary">
                  Cancelar
                </a>
                <button
                  type="submit"
                  class="btn-brand"
                  :disabled="submitting"
                >
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                  </svg>
                  <span x-text="submitting ? 'Creando...' : 'Crear Vendedor'"></span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer style="padding: 20px 24px; border-top: 1px solid var(--w3-border-light); font-size: 12px; color: #71717a; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <div>
        &copy; 2026 <strong>{{ _ENV['APP_NAME'] }}</strong>. Registro de vendedores.
      </div>
      <div>
        Sistema de inventario por lote y trazabilidad comercial.
      </div>
    </footer>
  </div>

</body>
{% endblock %}
