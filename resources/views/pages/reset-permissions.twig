{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/reset-permissions.css">
{% endblock %}

{% block title %}Permisos de Vendedor{% endblock %}

{% block content %}
<body
  x-data='{
    isDarkMode: window.matchMedia(`(prefers-color-scheme: dark)`).matches,
    sidebarOpen: false,
    submitting: false,
    allPermissions: JSON.parse(`{{ availablePermissions|json_encode }}`),
    selectedPermissions: (function() {
      try {
        var raw = `{{ seller.permissions|default("[]")|e("js") }}`;
        return typeof raw === `string` ? JSON.parse(raw) : (Array.isArray(raw) ? raw : []);
      } catch(e) {
        return [];
      }
    })(),
    init() {
      const mediaQuery = window.matchMedia(`(prefers-color-scheme: dark)`);
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener(`change`, (event) => {
        this.isDarkMode = event.matches;
      });
    },
    isSelected(key) {
      return this.selectedPermissions.includes(key);
    },
    toggle(key) {
      if (this.isSelected(key)) {
        this.selectedPermissions = this.selectedPermissions.filter(k => k !== key);
      } else {
        this.selectedPermissions.push(key);
      }
    },
    selectAll() {
      this.selectedPermissions = this.allPermissions.map(p => p.key);
    },
    clearAll() {
      this.selectedPermissions = [];
    }
  }'
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/vendedores'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Permisos de Vendedor',
      badge: 'Seguridad',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan y encabezado -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/vendedores" style="color: inherit; text-decoration: none;">Vendedores</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Permisos de {{ seller.email }}</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <div>
            <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
              Configurar Permisos de Acceso
            </h2>
            <p style="margin: 4px 0 0; font-size: 13px; color: #71717a;">
              Vendedor: <strong style="color: var(--w3-text-color);">{{ seller.email }}</strong> (ID #{{ seller.id }})
            </p>
          </div>
          <a href="/vendedores" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Equipo
          </a>
        </div>
      </div>

      <!-- Formulario de Permisos -->
      <div style="max-width: 800px; margin: 0 auto;">
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Permisos Granulares</span>
            </div>
            <div style="display: flex; gap: 8px;">
              <button
                type="button"
                class="btn-secondary"
                style="padding: 6px 10px; font-size: 12px;"
                @click="selectAll()"
              >
                Marcar Todos
              </button>
              <button
                type="button"
                class="btn-secondary"
                style="padding: 6px 10px; font-size: 12px;"
                @click="clearAll()"
              >
                Desmarcar Todos
              </button>
            </div>
          </div>

          <div style="padding: 24px;">
            {% if flash %}
              <div class="alert-error">
                <div style="font-weight: 700; margin-bottom: 4px;">Atención:</div>
                {% for key, error in flash %}
                  <div>&bull; {{ error is iterable ? error|join(', ') : error }}</div>
                {% endfor %}
              </div>
            {% endif %}

            <form
              method="post"
              novalidate
              @submit="submitting = true"
            >
              <!-- Selector oculto/sincronizado o checkboxes estándar -->
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px;">
                <template x-for="perm in allPermissions" :key="perm.key">
                  <label
                    class="permission-tile"
                    :class="{ 'selected': isSelected(perm.key) }"
                  >
                    <input
                      type="checkbox"
                      name="permissions[]"
                      :value="perm.key"
                      :checked="isSelected(perm.key)"
                      @change="toggle(perm.key)"
                      class="custom-checkbox"
                    >
                    <div style="flex: 1;">
                      <div style="display: flex; align-items: center; justify-content: space-between;">
                        <span style="font-weight: 700; font-size: 14px;" x-text="perm.name"></span>
                        <span
                          class="badge-pill"
                          :class="perm.category === 'Clientes' ? 'badge-red' : 'badge-gray'"
                          style="font-size: 10px;"
                          x-text="perm.category"
                        ></span>
                      </div>
                      <div style="font-size: 12px; color: #71717a; margin-top: 4px; line-height: 1.4;" x-text="perm.desc"></div>
                      <div style="font-size: 11px; font-family: monospace; color: #a1a1aa; margin-top: 6px;">
                        <span style="opacity: 0.6;">identificador: </span><span x-text="perm.key"></span>
                      </div>
                    </div>
                  </label>
                </template>
              </div>

              <!-- Contador de seleccionados y botones -->
              <div style="margin-top: 32px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; border-top: 1px solid var(--w3-border-light); padding-top: 20px;">
                <div style="font-size: 13px; color: #71717a;">
                  <strong x-text="selectedPermissions.length"></strong> de <span x-text="allPermissions.length"></span> permisos concedidos
                </div>

                <div style="display: flex; align-items: center; gap: 12px;">
                  <a href="/vendedores" class="btn-secondary">
                    Cancelar
                  </a>
                  <button
                    type="submit"
                    class="btn-brand"
                    :disabled="submitting"
                  >
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span x-text="submitting ? 'Guardando...' : 'Guardar Permisos'"></span>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Permisos de vendedores'},
    ) }}
  </div>

</body>
{% endblock %}
