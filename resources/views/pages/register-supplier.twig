<form method="post" novalidate>
  <input name="name" required placeholder="Nombre">
  <input name="tax_id" required placeholder="RIF">
  <textarea name="address" required placeholder="Dirección"></textarea>
  <input type="tel" name="phone" required placeholder="Teléfono">
  <input name="seller" required placeholder="Vendedor">
  <input name="alias" required placeholder="Alias">
  <input type="submit">
</form>
