{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/sales.css">
{% endblock %}

{% block title %}Historial de Ventas{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    search: '',
    salesList: [
      {% for sale in sales %}
      {
        id: {{ sale.id }},
        code: '{{ sale.code|e('js') }}',
        client_name: '{{ sale.client_name|e('js') }}',
        seller_email: '{{ sale.seller_email|e('js') }}',
        created_at: '{{ sale.created_at|e('js') }}',
        usd_ves: {{ sale.usd_ves }},
        usd_cop: {{ sale.usd_cop }},
        total_usd: {{ sale.total_usd }},
        items_count: {{ sale.items_count }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    },
    get filteredSales() {
      if (!this.search.trim()) {
        return this.salesList;
      }
      const q = this.search.toLowerCase().trim();
      return this.salesList.filter(s =>
        (s.code && s.code.toLowerCase().includes(q)) ||
        (s.client_name && s.client_name.toLowerCase().includes(q)) ||
        (s.seller_email && s.seller_email.toLowerCase().includes(q)) ||
        (s.created_at && s.created_at.toLowerCase().includes(q))
      );
    },
    get totalVolumeUSD() {
      return this.salesList.reduce((sum, s) => sum + Number(s.total_usd), 0);
    },
    formatUSD(val) {
      return '$' + Number(val).toFixed(2);
    },
    formatVES(usd, rate) {
      return (Number(usd) * Number(rate)).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Bs';
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/ventas'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Ventas y Facturación',
      badge: 'Facturación',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Notificación de Errores Flash -->
      {% if flash %}
        <div class="alert-error">
          <div style="font-weight: 700; margin-bottom: 4px;">Atención:</div>
          {% for key, error in flash %}
            <div>&bull; {{ error is iterable ? error|join(', ') : error }}</div>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Breadcrumb y título -->
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
          <div style="font-size: 12px; color: #71717a; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
            <span>&rsaquo;</span>
            <span style="color: var(--brand-red); font-weight: 600;">Ventas</span>
          </div>
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Historial de Ventas y Facturación
          </h2>
          <p style="margin: 4px 0 0; font-size: 13px; color: #71717a;">
            Registro histórico de transacciones realizadas en el punto de venta con trazabilidad por lote y preservación de cotización.
          </p>
        </div>

        <a href="/ventas/registrar" class="btn-brand">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Registrar Venta
        </a>
      </div>

      <!-- Métricas rápidas -->
      <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div class="kpi-card">
          <div class="kpi-icon red">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Total Facturas</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px;">{{ sales|length }}</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon green">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Volumen Total (USD)</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px; color: #22c55e;" x-text="formatUSD(totalVolumeUSD)"></div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon blue">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Transacciones</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px; color: #3b82f6;" x-text="filteredSales.length"></div>
          </div>
        </div>
      </section>

      <!-- Tabla y Filtro -->
      <div class="panel-card">
        <div class="panel-header">
          <!-- Buscador en vivo -->
          <div class="search-wrapper">
            <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              placeholder="Buscar por código, cliente, vendedor, fecha..."
              x-model="search"
              aria-label="Buscar venta"
            >
          </div>

          <!-- Contador de resultados -->
          <div style="font-size: 13px; color: #71717a; font-weight: 500;">
            <span x-text="'Mostrando ' + filteredSales.length + ' de ' + salesList.length + ' facturas'"></span>
          </div>
        </div>

        {% if sales is empty %}
          <!-- Estado Vacío -->
          <div style="text-align: center; padding: 64px 20px;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background-color: rgba(220, 38, 38, 0.1); color: var(--brand-red); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
              <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700;">No hay ventas registradas</h3>
            <p style="margin: 0 auto; font-size: 13px; color: #71717a; max-width: 440px; line-height: 1.5;">
              Aún no se han completado transacciones de venta. Las facturas procesadas desde el Punto de Venta aparecerán aquí con su detalle de ítems y cotización.
            </p>
          </div>
        {% else %}
          <div style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 70px;"># ID</th>
                  <th>Código de Venta</th>
                  <th>Cliente</th>
                  <th>Vendedor</th>
                  <th>Fecha</th>
                  <th>Ítems</th>
                  <th style="text-align: right;">Total USD</th>
                  <th style="text-align: right;">Total VES (Ref)</th>
                  <th style="text-align: center; width: 130px;">Acción</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="sale in filteredSales" :key="sale.id">
                  <tr>
                    <!-- ID -->
                    <td style="font-weight: 700; color: #71717a; font-family: monospace;">
                      #<span x-text="String(sale.id).padStart(3, '0')"></span>
                    </td>

                    <!-- Código -->
                    <td>
                      <a :href="'/ventas/' + sale.id" style="text-decoration: none;">
                        <span class="badge-pill badge-gray" style="font-family: monospace; font-size: 12px; cursor: pointer;" x-text="sale.code"></span>
                      </a>
                    </td>

                    <!-- Cliente -->
                    <td>
                      <div style="font-weight: 700; font-size: 14px;" x-text="sale.client_name"></div>
                    </td>

                    <!-- Vendedor -->
                    <td>
                      <div style="font-size: 13px; color: #a1a1aa;" x-text="sale.seller_email"></div>
                    </td>

                    <!-- Fecha -->
                    <td style="font-size: 13px; color: #a1a1aa;" x-text="sale.created_at"></td>

                    <!-- Cantidad de renglones -->
                    <td>
                      <span class="badge-pill badge-blue" x-text="sale.items_count + ' ítem(s)'"></span>
                    </td>

                    <!-- Total USD -->
                    <td style="text-align: right; font-weight: 800; font-size: 15px; color: #22c55e;" x-text="formatUSD(sale.total_usd)"></td>

                    <!-- Total VES referencial según tasa histórica de la venta -->
                    <td style="text-align: right; font-size: 13px; color: #a1a1aa; font-family: monospace;" x-text="formatVES(sale.total_usd, sale.usd_ves)"></td>

                    <!-- Ver Comprobante -->
                    <td style="text-align: center;">
                      <a :href="'/ventas/' + sale.id" class="btn-secondary" style="padding: 6px 10px; font-size: 12px;" title="Ver Comprobante">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <span>Ver</span>
                      </a>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>

            <!-- Sin resultados de búsqueda -->
            <div x-show="filteredSales.length === 0 && salesList.length > 0" style="text-align: center; padding: 40px 20px; color: #71717a; display: none;">
              <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="margin: 0 auto 12px; display: block; opacity: 0.4;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <p style="margin: 0; font-size: 14px;">No se encontraron facturas que coincidan con "<span x-text="search" style="font-weight: 600;"></span>"</p>
            </div>
          </div>
        {% endif %}
      </div>
    </main>

    <!-- Footer -->
    <footer style="padding: 20px 24px; border-top: 1px solid var(--w3-border-light); font-size: 12px; color: #71717a; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <div>
        &copy; 2026 <strong>{{ _ENV['APP_NAME'] }}</strong>. Historial de ventas y facturación.
      </div>
      <div>
        Sistema de inventario por lote y trazabilidad comercial.
      </div>
    </footer>
  </div>

</body>
{% endblock %}
