<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registrar Compra - {{ _ENV['APP_NAME'] }}</title>
  <link rel="stylesheet" href="/resources/styles/w3.css">
  <script defer src="/resources/scripts/alpinejs/dist/cdn.min.js"></script>
  <style>
    :root {
      --brand-red: #dc2626;
      --brand-red-hover: #b91c1c;
      --brand-red-glow: rgba(220, 38, 38, 0.25);
      --brand-black: #0d0d11;
      --brand-charcoal: #18181b;
      --sidebar-width: 260px;
    }

    body {
      min-height: 100vh;
      background-color: var(--w3-surface-alt);
      color: var(--w3-text-color);
      font-family: var(--w3-font-family);
      margin: 0;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    body.w3-dark-mode {
      background-color: var(--w3-page-bg);
    }

    /* Sidebar Layout */
    .app-sidebar {
      width: var(--sidebar-width);
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      background-color: var(--brand-black);
      color: #ffffff;
      z-index: 20;
      overflow-y: auto;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      transition: transform 0.3s ease;
    }

    .app-main {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: margin-left 0.3s ease;
    }

    @media (max-width: 992px) {
      .app-sidebar {
        transform: translateX(-100%);
      }
      .app-sidebar.open {
        transform: translateX(0);
      }
      .app-main {
        margin-left: 0;
      }
    }

    /* Topbar */
    .app-topbar {
      height: 64px;
      background-color: var(--w3-surface);
      border-bottom: 1px solid var(--w3-border-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 10;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    /* Brand Header in Sidebar */
    .sidebar-brand {
      padding: 20px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-bottom: 2px solid var(--brand-red);
      background-color: #08080a;
    }

    .brand-avatar {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      object-fit: cover;
      border: 1.5px solid var(--brand-red);
      box-shadow: 0 2px 10px var(--brand-red-glow);
    }

    /* Navigation Links */
    .nav-group-title {
      padding: 16px 20px 6px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #71717a;
      font-weight: 700;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 20px;
      color: #a1a1aa;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      border-left: 3px solid transparent;
      transition: all 0.2s ease;
    }

    .nav-item:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.05);
      border-left-color: #71717a;
    }

    .nav-item.active {
      color: #ffffff;
      background-color: rgba(220, 38, 38, 0.12);
      border-left-color: var(--brand-red);
      font-weight: 600;
    }

    .nav-item svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    /* Buttons */
    .btn-brand {
      background-color: var(--brand-red);
      color: #ffffff;
      border: 1px solid var(--brand-red);
      padding: 10px 20px;
      font-weight: 600;
      font-size: 14px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-brand:hover {
      background-color: var(--brand-red-hover);
      border-color: var(--brand-red-hover);
      color: #ffffff;
    }

    .btn-brand:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .btn-secondary {
      background-color: transparent;
      color: inherit;
      border: 1px solid var(--w3-border-color);
      padding: 10px 18px;
      font-weight: 500;
      font-size: 14px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-secondary:hover {
      background-color: var(--w3-hover-bg);
      color: var(--w3-hover-text);
    }

    .btn-danger-outline {
      background-color: transparent;
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.4);
      padding: 6px 12px;
      font-weight: 500;
      font-size: 13px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-danger-outline:hover {
      background-color: rgba(239, 68, 68, 0.08);
    }

    /* Panel Card */
    .panel-card {
      background-color: var(--w3-surface);
      border-radius: 12px;
      border: 1px solid var(--w3-border-light);
      overflow: hidden;
      margin-bottom: 24px;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .panel-header {
      padding: 20px 24px;
      border-bottom: 1px solid var(--w3-border-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Form Inputs */
    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      color: var(--w3-text-color);
    }

    .form-input {
      width: 100%;
      background-color: var(--w3-surface-alt);
      color: var(--w3-text-color);
      border: 1px solid var(--w3-border-color);
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 14px;
      outline: none;
      box-sizing: border-box;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-input:focus {
      border-color: var(--brand-red);
      box-shadow: 0 0 0 3px var(--brand-red-glow);
    }

    .form-hint {
      font-size: 12px;
      color: #71717a;
      margin-top: 6px;
      line-height: 1.4;
    }

    /* Badges */
    .badge-pill {
      display: inline-block;
      padding: 3px 10px;
      font-size: 11px;
      font-weight: 700;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-red {
      background-color: rgba(220, 38, 38, 0.15);
      color: var(--brand-red);
      border: 1px solid rgba(220, 38, 38, 0.3);
    }

    /* Alert error box */
    .alert-error {
      background-color: rgba(239, 68, 68, 0.1);
      border-left: 4px solid var(--brand-red);
      color: #ef4444;
      padding: 12px 16px;
      border-radius: 0 8px 8px 0;
      margin-bottom: 20px;
      font-size: 13px;
      line-height: 1.5;
    }

    /* Items table */
    .items-table {
      width: 100%;
      border-collapse: collapse;
    }

    .items-table th {
      padding: 10px 12px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #71717a;
      font-weight: 700;
      border-bottom: 1px solid var(--w3-border-light);
      text-align: left;
    }

    .items-table td {
      padding: 10px 12px;
      vertical-align: middle;
    }

    .items-table tr + tr td {
      border-top: 1px solid var(--w3-border-light);
    }

    .item-input {
      width: 100%;
      background-color: var(--w3-surface-alt);
      color: var(--w3-text-color);
      border: 1px solid var(--w3-border-color);
      border-radius: 6px;
      padding: 8px 12px;
      font-size: 13px;
      outline: none;
      box-sizing: border-box;
      transition: border-color 0.2s ease;
    }

    .item-input:focus {
      border-color: var(--brand-red);
    }

    /* Overlay for mobile drawer */
    .sidebar-backdrop {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.6);
      z-index: 15;
    }
  </style>
</head>
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    submitting: false,
    suppliersList: [
      {% for s in suppliers %}
      { id: {{ s.id }}, name: '{{ s.name|e('js') }}', alias: '{{ s.alias|e('js') }}' }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    productsList: [
      {% for p in products %}
      { id: {{ p.id }}, name: '{{ p.name|e('js') }}', category: '{{ p.category|e('js') }}' }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    items: [{ product_id: '', quantity: '', cost: '' }],
    addItem() {
      this.items.push({ product_id: '', quantity: '', cost: '' });
    },
    removeItem(index) {
      if (this.items.length > 1) {
        this.items.splice(index, 1);
      }
    },
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>

  <!-- Telón de fondo móvil -->
  <div
    class="sidebar-backdrop"
    x-show="sidebarOpen"
    @click="sidebarOpen = false"
    x-transition:enter="w3-animate-opacity"
    x-transition:leave="w3-animate-opacity"
    style="display: none;"
  ></div>

  <!-- Barra lateral (Sidebar) -->
  <aside class="app-sidebar" :class="{ 'open': sidebarOpen }">
    <div class="sidebar-brand">
      <img
        src="/resources/images/banner.jpg"
        alt="{{ _ENV['APP_NAME'] }}"
        class="brand-avatar"
        onerror="this.style.display='none'"
      >
      <div style="overflow: hidden;">
        <div style="font-weight: 800; font-size: 13px; text-transform: uppercase; color: #ffffff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {{ _ENV['APP_NAME'] }}
        </div>
        <div style="font-size: 11px; color: #a1a1aa; display: flex; align-items: center; gap: 4px; margin-top: 2px;">
          <span style="width: 7px; height: 7px; border-radius: 50%; background-color: #22c55e; display: inline-block;"></span>
          Sistema en línea
        </div>
      </div>
    </div>

    <!-- Navegación principal -->
    <nav style="padding: 8px 0 24px;">
      <div class="nav-group-title">Principal</div>

      <a href="/" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Dashboard</span>
      </a>

      <div class="nav-group-title">Gestión de Negocio</div>

      <a href="/clientes" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span>Clientes</span>
      </a>

      <a href="/proveedores" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <span>Proveedores</span>
      </a>

      <a href="/vendedores" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span>Vendedores</span>
      </a>

      <a href="/cotizaciones" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Tasas de Cambio</span>
      </a>

      <div class="nav-group-title">Módulos de Repuestos</div>

      <a href="/productos" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <span>Catálogo de Productos</span>
      </a>

      <a href="/compras" class="nav-item active">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <span>Inventario y Lotes</span>
      </a>

      <a href="/ventas" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span>Ventas y Facturación</span>
      </a>

      <div class="nav-group-title">Sistema y Seguridad</div>

      <a href="/actualizar-clave" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Actualizar Contraseña</span>
      </a>

      <a href="/salir" class="nav-item" style="color: #ef4444;">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Cerrar Sesión</span>
      </a>
    </nav>
  </aside>

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    <!-- Topbar -->
    <header class="app-topbar">
      <div style="display: flex; align-items: center; gap: 14px;">
        <button
          type="button"
          class="btn-secondary w3-hide-large"
          @click="sidebarOpen = true"
          aria-label="Abrir menú"
        >
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <h1 style="margin: 0; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <span>Registrar Compra</span>
          <span class="badge-pill badge-red w3-hide-small">Formulario</span>
        </h1>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <button
          type="button"
          class="btn-secondary"
          @click="isDarkMode = !isDarkMode"
          :title="isDarkMode ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'"
          aria-label="Alternar modo de color"
        >
          <svg x-show="isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg x-show="!isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <a href="/salir" class="btn-brand" style="padding: 7px 14px;" title="Cerrar sesión actual">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="w3-hide-small">Salir</span>
        </a>
      </div>
    </header>

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan y encabezado -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/compras" style="color: inherit; text-decoration: none;">Compras</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Nueva Compra</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Registrar Nueva Compra
          </h2>
          <a href="/compras" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Historial
          </a>
        </div>
      </div>

      <form
        method="post"
        novalidate
        @submit="submitting = true"
        style="max-width: 860px; margin: 0 auto;"
      >

        <!-- ── Sección 1: Datos de la Orden ─────────────────────────────── -->
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Datos de la Orden de Compra</span>
            </div>
            <span class="badge-pill badge-red">Requerido</span>
          </div>

          <div style="padding: 24px;">
            <!-- Notificación de Errores Flash -->
            {% if flash %}
              <div class="alert-error">
                <div style="font-weight: 700; margin-bottom: 4px;">Atención:</div>
                {% for key, error in flash %}
                  <div>&bull; {{ error is iterable ? error|join(', ') : error }}</div>
                {% endfor %}
              </div>
            {% endif %}

            <div class="w3-row-padding" style="margin: 0 -8px;">
              <!-- Proveedor -->
              <div class="w3-col l6 m12" style="padding: 0 8px;">
                <div class="form-group">
                  <label for="supplier_id" class="form-label">
                    Proveedor <span style="color: var(--brand-red);">*</span>
                  </label>
                  <select
                    id="supplier_id"
                    name="supplier_id"
                    class="form-input"
                    required
                  >
                    <option value="" disabled selected>Seleccionar proveedor…</option>
                    {% for s in suppliers %}
                      <option value="{{ s.id }}">{{ s.name }} ({{ s.alias }})</option>
                    {% endfor %}
                  </select>
                  <div class="form-hint">Empresa o persona de quien se adquiere la mercancía.</div>
                </div>
              </div>

              <!-- Código de Factura -->
              <div class="w3-col l6 m12" style="padding: 0 8px;">
                <div class="form-group">
                  <label for="supplier_invoice_code" class="form-label">
                    Código de Factura <span style="color: var(--brand-red);">*</span>
                  </label>
                  <input
                    type="text"
                    id="supplier_invoice_code"
                    name="supplier_invoice_code"
                    class="form-input"
                    required
                    placeholder="Ej: FAC-2026-00142"
                    autofocus
                  >
                  <div class="form-hint">Número o código único de la factura emitida por el proveedor.</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ── Sección 2: Ítems de la Compra ────────────────────────────── -->
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Ítems de la Compra</span>
            </div>
            <button
              type="button"
              class="btn-brand"
              style="padding: 8px 14px; font-size: 13px;"
              @click="addItem()"
            >
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Agregar Ítem
            </button>
          </div>

          <div style="padding: 0 24px 24px;">
            <div style="overflow-x: auto; margin-top: 16px;">
              <table class="items-table">
                <thead>
                  <tr>
                    <th style="width: 40%;">Producto</th>
                    <th style="width: 22%;">Cantidad</th>
                    <th style="width: 22%;">Costo unitario (USD)</th>
                    <th style="width: 16%; text-align: center;">Acción</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="(item, index) in items" :key="index">
                    <tr>
                      <!-- Producto -->
                      <td>
                        <select
                          :name="'product_id[]'"
                          x-model="item.product_id"
                          class="item-input"
                          required
                        >
                          <option value="" disabled>Seleccionar…</option>
                          <template x-for="p in productsList" :key="p.id">
                            <option :value="p.id" x-text="p.name + ' — ' + p.category"></option>
                          </template>
                        </select>
                      </td>

                      <!-- Cantidad -->
                      <td>
                        <input
                          type="number"
                          :name="'quantity[]'"
                          x-model="item.quantity"
                          class="item-input"
                          min="0.01"
                          step="0.01"
                          placeholder="0.00"
                          required
                        >
                      </td>

                      <!-- Costo -->
                      <td>
                        <input
                          type="number"
                          :name="'cost[]'"
                          x-model="item.cost"
                          class="item-input"
                          min="0.01"
                          step="0.01"
                          placeholder="0.00"
                          required
                        >
                      </td>

                      <!-- Eliminar fila -->
                      <td style="text-align: center;">
                        <button
                          type="button"
                          class="btn-danger-outline"
                          @click="removeItem(index)"
                          :disabled="items.length === 1"
                          title="Eliminar ítem"
                        >
                          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                          Quitar
                        </button>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>

            <div style="margin-top: 12px; font-size: 12px; color: #71717a;">
              <span x-text="items.length + ' ítem(s) agregado(s)'"></span>
              &mdash; Los costos se registran en USD.
            </div>
          </div>
        </div>

        <!-- ── Botones de acción ─────────────────────────────────────────── -->
        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 12px; padding-bottom: 16px;">
          <a href="/compras" class="btn-secondary">
            Cancelar
          </a>
          <button
            type="submit"
            class="btn-brand"
            :disabled="submitting"
          >
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span x-text="submitting ? 'Guardando...' : 'Guardar Compra'"></span>
          </button>
        </div>

      </form>
    </main>

    <!-- Footer -->
    <footer style="padding: 20px 24px; border-top: 1px solid var(--w3-border-light); font-size: 12px; color: #71717a; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <div>
        &copy; 2026 <strong>{{ _ENV['APP_NAME'] }}</strong>. Registro de compras por lote.
      </div>
      <div>
        Sistema de inventario por lote y trazabilidad comercial.
      </div>
    </footer>
  </div>

</body>
</html>
