{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/products.css">
{% endblock %}

{% block title %}Catálogo de Productos{% endblock %}

{% block content %}
<body x-data="{
  search: '',
  deleteModalOpen: false,
  productToDelete: null,
  productsList: [
    {% for product in products %}
    {
      id: {{ product.id }},
      name: '{{ product.name|e('js') }}',
      category: '{{ product.category|e('js') }}',
      price: {{ product.price }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  get filteredProducts() {
    if (!this.search.trim()) return this.productsList;
    const q = this.search.toLowerCase().trim();
    return this.productsList.filter(p =>
      p.name.toLowerCase().includes(q) ||
      p.category.toLowerCase().includes(q)
    );
  },
  formatPrice(value) {
    return '$\u00a0' + parseFloat(value).toFixed(2);
  },
  openDelete(product) {
    this.productToDelete = product;
    this.deleteModalOpen = true;
  },
  confirmDelete() {
    if (this.productToDelete) {
      window.location.href = '/productos/' + this.productToDelete.id + '/eliminar';
    }
  }
}">
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/productos'}) }}

  <!-- Área principal -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Catálogo de Productos',
      badge: 'Gestión',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Encabezado y acción -->
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
          <div style="font-size: 12px; color: #71717a; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
            <span>&rsaquo;</span>
            <span style="color: var(--brand-red); font-weight: 600;">Productos</span>
          </div>
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Catálogo de Repuestos
          </h2>
          <p style="margin: 4px 0 0; font-size: 13px; color: #71717a;">
            Gestiona los productos y sus precios de venta en USD.
          </p>
        </div>

        <a href="/productos/registrar" class="btn-brand" style="padding: 10px 18px; font-size: 14px;">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Nuevo Producto</span>
        </a>
      </div>

      <!-- KPIs -->
      <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div class="kpi-card">
          <div class="kpi-icon red">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Total Productos</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px;">{{ products|length }}</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon blue">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Búsqueda activa</div>
            <div style="font-size: 18px; font-weight: 800; margin-top: 4px;" x-text="filteredProducts.length + ' resultado' + (filteredProducts.length !== 1 ? 's' : '')">—</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon gray">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Moneda base</div>
            <div style="font-size: 18px; font-weight: 800; margin-top: 4px;">USD</div>
          </div>
        </div>
      </section>

      <!-- Tabla -->
      <div class="panel-card">
        <div class="panel-header">
          <div class="search-wrapper">
            <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              placeholder="Buscar por nombre o categoría..."
              x-model="search"
              aria-label="Buscar producto"
            >
          </div>

          <div style="font-size: 13px; color: #71717a; font-weight: 500;">
            <span x-text="'Mostrando ' + filteredProducts.length + ' de ' + productsList.length + ' productos'"></span>
          </div>
        </div>

        {% if products is empty %}
          <!-- Estado vacío -->
          <div style="text-align: center; padding: 64px 20px;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background-color: rgba(220, 38, 38, 0.1); color: var(--brand-red); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
              <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700;">No hay productos en el catálogo</h3>
            <p style="margin: 0 auto 20px; font-size: 13px; color: #71717a; max-width: 400px; line-height: 1.5;">
              Registra el primer producto para comenzar a gestionar el inventario por lote.
            </p>
            <a href="/productos/registrar" class="btn-brand">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Registrar Primer Producto</span>
            </a>
          </div>
        {% else %}
          <div style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 80px;"># ID</th>
                  <th>Producto</th>
                  <th style="width: 160px;">Categoría</th>
                  <th style="text-align: right; width: 120px;">Precio (USD)</th>
                  <th style="text-align: right; width: 180px;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="product in filteredProducts" :key="product.id">
                  <tr>
                    <!-- ID -->
                    <td style="font-weight: 700; color: #71717a; font-family: monospace;">
                      #<span x-text="String(product.id).padStart(3, '0')"></span>
                    </td>

                    <!-- Nombre e ícono -->
                    <td>
                      <div style="display: flex; align-items: center; gap: 12px;">
                        <div class="product-icon">
                          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                        </div>
                        <div style="font-weight: 600; font-size: 14px;" x-text="product.name"></div>
                      </div>
                    </td>

                    <!-- Categoría -->
                    <td>
                      <span class="badge-pill badge-blue" x-text="product.category"></span>
                    </td>

                    <!-- Precio -->
                    <td style="text-align: right; font-weight: 700; font-size: 15px;" x-text="formatPrice(product.price)"></td>

                    <!-- Acciones -->
                    <td style="text-align: right;">
                      <div style="display: inline-flex; align-items: center; gap: 8px;">
                        <!-- Editar -->
                        <a
                          :href="'/productos/' + product.id"
                          class="btn-secondary"
                          style="padding: 6px 10px; font-size: 12px;"
                          title="Editar producto"
                        >
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                          </svg>
                          <span>Editar</span>
                        </a>

                        <!-- Eliminar -->
                        <button
                          type="button"
                          class="btn-danger-outline"
                          @click="openDelete(product)"
                          title="Eliminar producto"
                        >
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                          <span>Eliminar</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>

          <!-- Sin resultados de búsqueda -->
          <div
            x-show="filteredProducts.length === 0"
            style="text-align: center; padding: 48px 20px; display: none;"
          >
            <div style="font-size: 14px; font-weight: 600; margin-bottom: 4px;">No se encontraron resultados</div>
            <div style="font-size: 13px; color: #71717a;">
              Ningún producto coincide con "<strong x-text="search"></strong>".
            </div>
          </div>
        {% endif %}
      </div>
    </main>

    <!-- Modal de confirmación para eliminar -->
    <div
      class="modal-backdrop"
      x-show="deleteModalOpen"
      x-transition:enter="w3-animate-opacity"
      x-transition:leave="w3-animate-opacity"
      style="display: none;"
      @click.self="deleteModalOpen = false"
    >
      <div class="modal-box">
        <div style="display: flex; align-items: flex-start; gap: 14px;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 style="margin: 0; font-size: 17px; font-weight: 700;">¿Eliminar producto?</h3>
            <p style="margin: 8px 0 0; font-size: 13px; color: #71717a; line-height: 1.5;">
              ¿Estás seguro de que deseas eliminar el producto <strong x-text="productToDelete ? productToDelete.name : ''"></strong>? Esta acción borrará el registro del catálogo de forma permanente.
            </p>
          </div>
        </div>

        <div style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 10px;">
          <button
            type="button"
            class="btn-secondary"
            @click="deleteModalOpen = false"
          >
            Cancelar
          </button>
          <button
            type="button"
            class="btn-brand"
            style="background-color: #ef4444; border-color: #ef4444;"
            @click="confirmDelete()"
          >
            Sí, eliminar
          </button>
        </div>
      </div>
    </div>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Catálogo de repuestos'},
    ) }}
  </div>

</body>
{% endblock %}
