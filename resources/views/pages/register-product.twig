{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/register-product.css">
{% endblock %}

{% block title %}Registrar Producto{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    submitting: false,
    price: '',
    showMarginWarning: false,
    cost: '',
    checkMargin() {
      const p = parseFloat(this.price);
      const c = parseFloat(this.cost);
      if (!isNaN(p) && !isNaN(c) && c > 0) {
        const margin = ((p - c) / c) * 100;
        this.showMarginWarning = margin > 30;
      } else {
        this.showMarginWarning = false;
      }
    },
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/productos'}) }}

  <!-- Área principal -->
  <div class="app-main">
    <!-- Topbar -->
    <header class="app-topbar">
      <div style="display: flex; align-items: center; gap: 14px;">
        <button
          type="button"
          class="btn-secondary w3-hide-large"
          @click="sidebarOpen = true"
          aria-label="Abrir menú"
        >
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <h1 style="margin: 0; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <span>Registrar Producto</span>
          <span class="badge-pill badge-red w3-hide-small">Formulario</span>
        </h1>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <button
          type="button"
          class="btn-secondary"
          @click="isDarkMode = !isDarkMode"
          :title="isDarkMode ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'"
          aria-label="Alternar modo de color"
        >
          <svg x-show="isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg x-show="!isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <a href="/salir" class="btn-brand" style="padding: 7px 14px;" title="Cerrar sesión actual">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="w3-hide-small">Salir</span>
        </a>
      </div>
    </header>

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/productos" style="color: inherit; text-decoration: none;">Productos</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Nuevo Registro</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Registrar Nuevo Producto
          </h2>
          <a href="/productos" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Catálogo
          </a>
        </div>
      </div>

      <!-- Formulario -->
      <div style="max-width: 720px; margin: 0 auto;">
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Datos del Producto</span>
            </div>
            <span class="badge-pill badge-red">Requerido</span>
          </div>

          <div style="padding: 24px;">
            <!-- Errores flash -->
            {% if flash %}
              <div class="alert-error">
                <div style="font-weight: 700; margin-bottom: 4px;">Atención:</div>
                {% for key, error in flash %}
                  <div>&bull; {{ error is iterable ? error|join(', ') : error }}</div>
                {% endfor %}
              </div>
            {% endif %}

            <!-- Alerta de margen -->
            <div class="alert-warning" x-show="showMarginWarning" style="display: none;">
              <strong>Margen superior al 30%.</strong>
              En Venezuela el techo legal de ganancia para repuestos automotrices es del 30%.
              Verifica el precio antes de guardar.
            </div>

            <form method="post" novalidate @submit="submitting = true">

              <!-- Nombre del Producto -->
              <div class="form-group">
                <label for="product_name" class="form-label">
                  Nombre del Producto <span style="color: var(--brand-red);">*</span>
                </label>
                <input
                  type="text"
                  id="product_name"
                  name="name"
                  class="form-input"
                  required
                  placeholder="Ej: Filtro de Aceite Toyota Corolla"
                  autofocus
                >
                <div class="form-hint">Nombre descriptivo y único del repuesto.</div>
              </div>

              <!-- Categoría -->
              <div class="form-group">
                <label for="product_category" class="form-label">
                  Categoría <span style="color: var(--brand-red);">*</span>
                </label>
                <input
                  type="text"
                  id="product_category"
                  name="category"
                  class="form-input"
                  required
                  placeholder="Ej: Filtros, Frenos, Suspensión, Motor..."
                >
                <div class="form-hint">Agrupación del producto dentro del catálogo.</div>
              </div>

              <!-- Precio de venta (USD) -->
              <div class="form-group">
                <label for="product_price" class="form-label">
                  Precio de Venta (USD) <span style="color: var(--brand-red);">*</span>
                </label>
                <div class="price-wrapper">
                  <span class="price-prefix">$</span>
                  <input
                    type="number"
                    id="product_price"
                    name="price"
                    class="form-input"
                    required
                    min="0.01"
                    step="0.01"
                    placeholder="0.00"
                    x-model="price"
                    @input="checkMargin()"
                  >
                </div>
                <div class="form-hint">
                  Precio de venta base en dólares (USD). Se actualizará automáticamente si un lote de compra llega con un precio mayor.
                </div>
              </div>

              <!-- Acciones -->
              <div style="margin-top: 28px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--w3-border-light); padding-top: 20px;">
                <a href="/productos" class="btn-secondary">Cancelar</a>
                <button
                  type="submit"
                  class="btn-brand"
                  :disabled="submitting"
                >
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span x-text="submitting ? 'Guardando...' : 'Guardar Producto'"></span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer style="padding: 20px 24px; border-top: 1px solid var(--w3-border-light); font-size: 12px; color: #71717a; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <div>
        &copy; 2026 <strong>{{ _ENV['APP_NAME'] }}</strong>. Registro de productos.
      </div>
      <div>
        Sistema de inventario por lote y trazabilidad comercial.
      </div>
    </footer>
  </div>

</body>
{% endblock %}
