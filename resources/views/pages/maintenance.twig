{% extends "components/layout-login.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/maintenance.css">
{% endblock %}

{% block title %}Mantenimiento{% endblock %}

{% block content %}
<body>
  <button
    type="button"
    class="theme-toggle-btn"
    @click="isDarkMode = !isDarkMode"
    aria-label="Alternar modo oscuro"
  >
    <svg x-show="isDarkMode" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <svg x-show="!isDarkMode" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
  </button>

  <main class="maintenance-card w3-animate-opacity">
    <header class="card-header w3-center">
      <img src="/resources/images/banner.jpg" alt="{{ _ENV['APP_NAME'] }}" class="brand-logo">
      <div style="margin-top: 20px;">
        <div class="status-badge">Modo Mantenimiento</div>
      </div>
    </header>
    
    <div class="card-content w3-center">
      <h1 class="title">Estamos mejorando el sistema</h1>
      <p class="text">
        Lamentamos los inconvenientes. El sistema de <strong>{{ _ENV['APP_NAME'] }}</strong> se encuentra en mantenimiento programado para optimizar la experiencia de gestión.
      </p>
      <p class="w3-small" style="color: #71717a;">
        Por favor, intenta acceder nuevamente en unos minutos.
      </p>
    </div>
  </main>
</body>
{% endblock %}
