{% extends "components/layout-login.twig" %}

{% block content %}
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar Contraseña - {{ _ENV['APP_NAME'] }}</title>
  <link rel="icon" type="image/jpeg" href="/resources/images/favicon.jpg">
  <link rel="stylesheet" href="/resources/styles/w3.css">
  <script defer src="/resources/scripts/alpinejs/dist/cdn.min.js"></script>
  <style>
    :root {
      --brand-red: #dc2626;
      --brand-red-hover: #b91c1c;
      --brand-red-glow: rgba(220, 38, 38, 0.35);
      --brand-black: #0d0d11;
      --brand-gray-dark: #18181b;
      --brand-gray-light: #f4f4f5;
    }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-image: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), url('/resources/images/background.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
      background-color: var(--brand-black);
      color: var(--w3-text-color);
      padding: 16px;
      transition: background 0.3s ease, color 0.3s ease;
    }
    body.w3-dark-mode {
      background-image: linear-gradient(rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.8)), url('/resources/images/background.jpg');
    }
    .auth-card {
      width: 100%;
      max-width: 440px;
      border-radius: 14px;
      overflow: hidden;
      background-color: var(--w3-surface);
      color: var(--w3-text-color);
      border: none;
      box-shadow: none;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    .card-header {
      background-color: var(--brand-black) !important;
      border-bottom: 3px solid var(--brand-red);
      position: relative;
    }
    .brand-logo {
      width: 96px;
      height: 96px;
      object-fit: cover;
      border-radius: 16px;
      box-shadow: 0 4px 16px var(--brand-red-glow);
      border: 2px solid var(--brand-red);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .brand-logo:hover {
      transform: scale(1.03);
      box-shadow: 0 6px 20px rgba(220, 38, 38, 0.5);
    }
    .theme-toggle-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: transparent;
      border: none;
      color: #9ca3af;
      cursor: pointer;
      padding: 6px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s ease, background-color 0.2s ease;
    }
    .theme-toggle-btn:hover {
      color: var(--brand-red);
      background-color: rgba(255, 255, 255, 0.05);
    }
    .form-input {
      background-color: transparent;
      color: inherit;
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--w3-border-color);
      border-radius: 8px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .form-input:focus {
      outline: none;
      border-color: var(--brand-red) !important;
      box-shadow: 0 0 0 3px var(--brand-red-glow);
    }
    .btn-submit {
      background-color: var(--brand-red);
      color: #ffffff;
      border: 1px solid var(--brand-red);
      padding: 11px 16px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      font-size: 14px;
      border-radius: 8px;
      cursor: pointer;
      width: 100%;
      transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.1s ease;
      box-shadow: 0 4px 14px var(--brand-red-glow);
    }
    .btn-submit:hover:not(:disabled) {
      background-color: var(--brand-red-hover);
      border-color: var(--brand-red-hover);
      box-shadow: 0 6px 18px rgba(220, 38, 38, 0.45);
      transform: translateY(-1px);
    }
    .btn-submit:disabled {
      background-color: #52525b;
      border-color: #52525b;
      color: #a1a1aa;
      cursor: not-allowed;
      box-shadow: none;
      opacity: 0.6;
    }
    .link-action {
      color: var(--brand-red);
      text-decoration: none;
      font-weight: 700;
      transition: color 0.2s ease, text-decoration 0.2s ease;
    }
    .link-action:hover {
      color: var(--brand-red-hover);
      text-decoration: underline;
    }
  </style>
</head>
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    email: '',
    submitting: false,
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    },
    get isEmailValid() {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.email.trim());
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>

  <main class="auth-card w3-animate-opacity">
    <!-- Encabezado con marca y temática Racing (Negro, Rojo y Gris) -->
    <header class="card-header w3-container w3-center w3-padding-24">
      <!-- Alternador de tema -->
      <button
        type="button"
        class="theme-toggle-btn"
        @click="isDarkMode = !isDarkMode"
        :title="isDarkMode ? 'Activar tema claro' : 'Activar tema oscuro'"
        aria-label="Alternar modo oscuro"
      >
        <!-- Sol (modo oscuro activo -> cambiar a claro) -->
        <svg x-show="isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Luna (modo claro activo -> cambiar a oscuro) -->
        <svg x-show="!isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Banner / Mascota de Motorepuestos Robles -->
      <img
        src="/resources/images/banner.jpg"
        alt="{{ _ENV['APP_NAME'] }}"
        class="brand-logo w3-margin-bottom"
        onerror="this.style.display='none'"
      >
      <h1 class="w3-large w3-bold" style="margin: 0; color: #ffffff; letter-spacing: 0.5px;">{{ _ENV['APP_NAME'] }}</h1>
      <p class="w3-small" style="margin: 4px 0 0; color: #a1a1aa;">Recuperación de contraseña</p>
    </header>

    <!-- Contenido del formulario -->
    <div class="w3-container" style="padding: 24px 28px 36px;">
      <p class="w3-small" style="margin: 0 0 20px; color: #a1a1aa; line-height: 1.5; text-align: center;">
        Ingresa tu correo electrónico registrado y te enviaremos un enlace para restablecer tu contraseña.
      </p>

      <form
        method="post"
        novalidate
        @submit="submitting = true"
      >
        <!-- Campo: Correo Electrónico -->
        <div class="w3-margin-bottom">
          <label for="email" class="w3-small w3-bold" style="display: block; margin-bottom: 6px;">
            Correo electrónico
          </label>
          <input
            id="email"
            class="form-input"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="ejemplo@correo.com"
            x-model="email"
            :style="email.length > 0 && !isEmailValid ? 'border-color: var(--brand-red) !important;' : ''"
          >
          <template x-if="email.length > 0 && !isEmailValid">
            <span class="w3-tiny" style="color: var(--brand-red); display: block; margin-top: 4px;">
              Ingresa una dirección de correo electrónico válida.
            </span>
          </template>
        </div>

        <!-- Botón de Envío -->
        <div class="w3-margin-top" style="margin-top: 24px;">
          <button
            type="submit"
            class="btn-submit"
            :disabled="submitting || !isEmailValid"
          >
            <span x-show="!submitting">Enviar enlace</span>
            <span x-show="submitting" style="display: none;">Enviando instrucciones...</span>
          </button>
        </div>
      </form>

      <!-- Pie y navegación hacia login con separación holgada -->
      <footer class="w3-center" style="margin-top: 40px; padding: 24px 0 12px; border-top: 1px solid var(--w3-border-light);">
        <p class="w3-small" style="margin: 0; color: #a1a1aa; line-height: 1.8;">
          ¿Recordaste tu clave?
          <a href="/auth/login" class="link-action" style="margin-left: 6px; display: inline-block;">
            Volver a iniciar sesión
          </a>
        </p>
      </footer>
    </div>
  </main>

</body>
{% endblock %}
