{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/clients.css">
{% endblock %}

{% block title %}Directorio de Clientes{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    search: '',
    deleteModalOpen: false,
    clientToDelete: null,
    clientsList: [
      {% for client in clients %}
      {
        id: {{ client.id }},
        name: '{{ client.name|e('js') }}'
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    },
    get filteredClients() {
      if (!this.search.trim()) {
        return this.clientsList;
      }
      const q = this.search.toLowerCase().trim();
      return this.clientsList.filter(c => c.name.toLowerCase().includes(q));
    },
    openDelete(client) {
      this.clientToDelete = client;
      this.deleteModalOpen = true;
    },
    confirmDelete() {
      if (this.clientToDelete) {
        window.location.href = '/clientes/' + this.clientToDelete.id + '/eliminar';
      }
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/clientes'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Directorio de Clientes',
      badge: 'Gestión',
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Barra de navegación y acción principal -->
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
          <div style="font-size: 12px; color: #71717a; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
            <span>&rsaquo;</span>
            <span style="color: var(--brand-red); font-weight: 600;">Clientes</span>
          </div>
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Clientes Registrados
          </h2>
          <p style="margin: 4px 0 0; font-size: 13px; color: #71717a;">
            Administra la cartera de compradores particulares y talleres automotrices.
          </p>
        </div>

        <div>
          <a href="/clientes/registrar" class="btn-brand" style="padding: 10px 18px; font-size: 14px;">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Nuevo Cliente</span>
          </a>
        </div>
      </div>

      <!-- Métricas rápidas -->
      <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div class="kpi-card">
          <div class="kpi-icon red">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Total Registrados</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px;">{{ clients|length }}</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon gray">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Estado Cartera</div>
            <div style="font-size: 18px; font-weight: 800; margin-top: 4px; color: #22c55e;">Activa</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon red">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div>
            <div style="font-size: 11px; color: #71717a; text-transform: uppercase; font-weight: 700;">Trazabilidad</div>
            <div style="font-size: 18px; font-weight: 800; margin-top: 4px;">Por Lote</div>
          </div>
        </div>
      </section>

      <!-- Tabla y Filtro -->
      <div class="panel-card">
        <div class="panel-header">
          <!-- Buscador en vivo -->
          <div class="search-wrapper">
            <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              placeholder="Buscar por nombre..."
              x-model="search"
              aria-label="Buscar cliente"
            >
          </div>

          <!-- Contador de clientes -->
          <div style="font-size: 13px; color: #71717a; font-weight: 500;">
            <span x-text="'Mostrando ' + filteredClients.length + ' de ' + clientsList.length + ' clientes'"></span>
          </div>
        </div>

        {% if clients is empty %}
          <!-- Estado Vacío Inicial -->
          <div style="text-align: center; padding: 64px 20px;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background-color: rgba(220, 38, 38, 0.1); color: var(--brand-red); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
              <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700;">No hay clientes registrados</h3>
            <p style="margin: 0 auto 20px; font-size: 13px; color: #71717a; max-width: 400px; line-height: 1.5;">
              Aún no tienes clientes en el sistema. Registra el primero para comenzar a asociar cotizaciones y ventas por lote.
            </p>
            <a href="/clientes/registrar" class="btn-brand">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Registrar Primer Cliente</span>
            </a>
          </div>
        {% else %}
          <div style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 80px;"># ID</th>
                  <th>Cliente</th>
                  <th>Categoría</th>
                  <th style="text-align: right; width: 180px;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="client in filteredClients" :key="client.id">
                  <tr>
                    <!-- ID -->
                    <td style="font-weight: 700; color: #71717a; font-family: monospace;">
                      #<span x-text="String(client.id).padStart(3, '0')"></span>
                    </td>

                    <!-- Nombre y Avatar -->
                    <td>
                      <div style="display: flex; align-items: center; gap: 12px;">
                        <div class="client-avatar" x-text="client.name.substring(0, 1).toUpperCase()"></div>
                        <div>
                          <div style="font-weight: 700; font-size: 14px;" x-text="client.name"></div>
                          <div style="font-size: 12px; color: #71717a; margin-top: 1px;">Consumidor / Taller</div>
                        </div>
                      </div>
                    </td>

                    <!-- Categoría / Estado -->
                    <td>
                      <span class="badge-pill badge-green">Activo</span>
                    </td>

                    <!-- Acciones -->
                    <td style="text-align: right;">
                      <div style="display: inline-flex; align-items: center; gap: 8px;">
                        <!-- Editar -->
                        <a
                          :href="'/clientes/' + client.id"
                          class="btn-secondary"
                          style="padding: 6px 10px; font-size: 12px;"
                          title="Editar cliente"
                        >
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                          </svg>
                          <span>Editar</span>
                        </a>

                        <!-- Eliminar -->
                        <button
                          type="button"
                          class="btn-danger-outline"
                          @click="openDelete(client)"
                          title="Eliminar cliente"
                        >
                          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                          <span>Eliminar</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>

          <!-- Si la búsqueda no arroja resultados -->
          <div
            x-show="filteredClients.length === 0"
            style="text-align: center; padding: 48px 20px; display: none;"
          >
            <div style="font-size: 14px; font-weight: 600; margin-bottom: 4px;">No se encontraron resultados</div>
            <div style="font-size: 13px; color: #71717a;">
              No existe ningún cliente que coincida con "<strong x-text="search"></strong>".
            </div>
          </div>
        {% endif %}
      </div>
    </main>

    <!-- Modal de confirmación para eliminar -->
    <div
      class="modal-backdrop"
      x-show="deleteModalOpen"
      x-transition:enter="w3-animate-opacity"
      x-transition:leave="w3-animate-opacity"
      style="display: none;"
      @click.self="deleteModalOpen = false"
    >
      <div class="modal-box">
        <div style="display: flex; align-items: flex-start; gap: 14px;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 style="margin: 0; font-size: 17px; font-weight: 700;">¿Eliminar cliente?</h3>
            <p style="margin: 8px 0 0; font-size: 13px; color: #71717a; line-height: 1.5;">
              ¿Estás seguro de que deseas eliminar al cliente <strong x-text="clientToDelete ? clientToDelete.name : ''"></strong>? Esta acción borrará el registro de forma permanente.
            </p>
          </div>
        </div>

        <div style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 10px;">
          <button
            type="button"
            class="btn-secondary"
            @click="deleteModalOpen = false"
          >
            Cancelar
          </button>
          <button
            type="button"
            class="btn-brand"
            style="background-color: #ef4444; border-color: #ef4444;"
            @click="confirmDelete()"
          >
            Sí, eliminar
          </button>
        </div>
      </div>
    </div>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Directorio de clientes'},
    ) }}
  </div>

</body>
{% endblock %}
