<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel de Control - {{ _ENV['APP_NAME'] }}</title>
  <link rel="icon" type="image/jpeg" href="/resources/images/favicon.jpg">
  <link rel="stylesheet" href="/resources/styles/w3.css">
  <script defer src="/resources/scripts/alpinejs/dist/cdn.min.js"></script>
  <style>
    :root {
      --brand-red: #dc2626;
      --brand-red-hover: #b91c1c;
      --brand-red-glow: rgba(220, 38, 38, 0.25);
      --brand-black: #0d0d11;
      --brand-charcoal: #18181b;
      --sidebar-width: 260px;
    }

    body {
      min-height: 100vh;
      background-color: var(--w3-surface-alt);
      color: var(--w3-text-color);
      font-family: var(--w3-font-family);
      margin: 0;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    body.w3-dark-mode {
      background-color: var(--w3-page-bg);
    }

    /* Sidebar Layout */
    .app-sidebar {
      width: var(--sidebar-width);
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      background-color: var(--brand-black);
      color: #ffffff;
      z-index: 20;
      overflow-y: auto;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      transition: transform 0.3s ease;
    }

    .app-main {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: margin-left 0.3s ease;
    }

    @media (max-width: 992px) {
      .app-sidebar {
        transform: translateX(-100%);
      }
      .app-sidebar.open {
        transform: translateX(0);
      }
      .app-main {
        margin-left: 0;
      }
    }

    /* Topbar */
    .app-topbar {
      height: 64px;
      background-color: var(--w3-surface);
      border-bottom: 1px solid var(--w3-border-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 10;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    /* Brand Header in Sidebar */
    .sidebar-brand {
      padding: 20px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-bottom: 2px solid var(--brand-red);
      background-color: #08080a;
    }

    .brand-avatar {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      object-fit: cover;
      border: 1.5px solid var(--brand-red);
      box-shadow: 0 2px 10px var(--brand-red-glow);
    }

    /* Navigation Links */
    .nav-group-title {
      padding: 16px 20px 6px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #71717a;
      font-weight: 700;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 20px;
      color: #a1a1aa;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      border-left: 3px solid transparent;
      transition: all 0.2s ease;
    }

    .nav-item:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.05);
      border-left-color: #71717a;
    }

    .nav-item.active {
      color: #ffffff;
      background-color: rgba(220, 38, 38, 0.12);
      border-left-color: var(--brand-red);
      font-weight: 600;
    }

    .nav-item svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    /* Cards and Panels */
    .kpi-card {
      background-color: var(--w3-surface);
      border-radius: 12px;
      padding: 20px;
      border: 1px solid var(--w3-border-light);
      display: flex;
      align-items: center;
      gap: 16px;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .kpi-card:hover {
      transform: translateY(-2px);
      border-color: var(--brand-red);
    }

    .kpi-icon {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .kpi-icon.red {
      background-color: rgba(220, 38, 38, 0.15);
      color: var(--brand-red);
    }

    .kpi-icon.gray {
      background-color: rgba(113, 113, 122, 0.15);
      color: #a1a1aa;
    }

    .panel-card {
      background-color: var(--w3-surface);
      border-radius: 12px;
      border: 1px solid var(--w3-border-light);
      overflow: hidden;
      margin-bottom: 24px;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .panel-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--w3-border-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Buttons */
    .btn-brand {
      background-color: var(--brand-red);
      color: #ffffff;
      border: 1px solid var(--brand-red);
      padding: 8px 16px;
      font-weight: 600;
      font-size: 13px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-brand:hover {
      background-color: var(--brand-red-hover);
      border-color: var(--brand-red-hover);
      color: #ffffff;
    }

    .btn-secondary {
      background-color: transparent;
      color: inherit;
      border: 1px solid var(--w3-border-color);
      padding: 8px 14px;
      font-weight: 500;
      font-size: 13px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-secondary:hover {
      background-color: var(--w3-hover-bg);
      color: var(--w3-hover-text);
    }

    /* Action Tile */
    .action-tile {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-radius: 10px;
      border: 1px solid var(--w3-border-light);
      text-decoration: none;
      color: inherit;
      background-color: var(--w3-surface);
      transition: all 0.2s ease;
    }

    .action-tile:hover {
      border-color: var(--brand-red);
      background-color: rgba(220, 38, 38, 0.04);
      transform: translateX(3px);
    }

    /* Overlay for mobile drawer */
    .sidebar-backdrop {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.6);
      z-index: 15;
    }

    /* Custom badge */
    .badge-pill {
      display: inline-block;
      padding: 2px 8px;
      font-size: 11px;
      font-weight: 700;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-red {
      background-color: rgba(220, 38, 38, 0.15);
      color: var(--brand-red);
      border: 1px solid rgba(220, 38, 38, 0.3);
    }
  </style>
</head>
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    userMenuOpen: false,
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>

  <!-- Telón de fondo móvil -->
  <div
    class="sidebar-backdrop"
    x-show="sidebarOpen"
    @click="sidebarOpen = false"
    x-transition:enter="w3-animate-opacity"
    x-transition:leave="w3-animate-opacity"
    style="display: none;"
  ></div>

  <!-- Barra lateral (Sidebar) -->
  <aside class="app-sidebar" :class="{ 'open': sidebarOpen }">
    <!-- Marca corporativa -->
    <div class="sidebar-brand">
      <img
        src="/resources/images/banner.jpg"
        alt="{{ _ENV['APP_NAME'] }}"
        class="brand-avatar"
        onerror="this.style.display='none'"
      >
      <div style="overflow: hidden;">
        <div style="font-weight: 800; font-size: 13px; text-transform: uppercase; color: #ffffff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {{ _ENV['APP_NAME'] }}
        </div>
        <div style="font-size: 11px; color: #a1a1aa; display: flex; align-items: center; gap: 4px; margin-top: 2px;">
          <span style="width: 7px; height: 7px; border-radius: 50%; background-color: #22c55e; display: inline-block;"></span>
          Sistema en línea
        </div>
      </div>
    </div>

    <!-- Navegación principal -->
    <nav style="padding: 8px 0 24px;">
      <div class="nav-group-title">Principal</div>
      
      <a href="/" class="nav-item active">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Dashboard</span>
      </a>

      <div class="nav-group-title">Gestión de Negocio</div>

      <a href="/clientes" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span>Clientes</span>
      </a>

      <a href="/vendedores" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span>Vendedores</span>
      </a>

      <a href="/cotizaciones" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Tasas de Cambio</span>
      </a>

      <div class="nav-group-title">Módulos de Repuestos</div>

      <a href="#inventario" class="nav-item" @click.prevent="alert('Módulo de inventario y lotes en proceso')">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <span>Inventario y Lotes</span>
      </a>

      <a href="#pos" class="nav-item" @click.prevent="alert('Punto de venta y facturación en proceso')">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span>Punto de Venta (POS)</span>
      </a>

      <div class="nav-group-title">Sistema y Seguridad</div>

      <a href="/actualizar-clave" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Actualizar Contraseña</span>
      </a>

      <a href="/salir" class="nav-item" style="color: #ef4444;">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Cerrar Sesión</span>
      </a>
    </nav>
  </aside>

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    <!-- Barra superior (Topbar) -->
    <header class="app-topbar">
      <div style="display: flex; align-items: center; gap: 14px;">
        <!-- Botón menú móvil -->
        <button
          type="button"
          class="btn-secondary w3-hide-large"
          @click="sidebarOpen = true"
          aria-label="Abrir menú"
        >
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <h1 style="margin: 0; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <span>Panel de Control</span>
          <span class="badge-pill badge-red w3-hide-small">Operaciones</span>
        </h1>
      </div>

      <!-- Acciones de la barra superior -->
      <div style="display: flex; align-items: center; gap: 10px;">
        <!-- Botón alternador de tema -->
        <button
          type="button"
          class="btn-secondary"
          @click="isDarkMode = !isDarkMode"
          :title="isDarkMode ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'"
          aria-label="Alternar modo de color"
        >
          <!-- Sol (cuando está oscuro) -->
          <svg x-show="isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Luna (cuando está claro) -->
          <svg x-show="!isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Botón de salir -->
        <a href="/salir" class="btn-brand" style="padding: 7px 14px;" title="Cerrar sesión actual">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="w3-hide-small">Salir</span>
        </a>
      </div>
    </header>

    <!-- Contenido del Dashboard -->
    <main style="padding: 24px; flex: 1;">
      <!-- Hero de Bienvenida Racing -->
      <section style="background: linear-gradient(135deg, #0d0d11 0%, #1f1f23 100%); border-bottom: 3px solid var(--brand-red); border-radius: 14px; padding: 28px 24px; color: #ffffff; margin-bottom: 24px; box-shadow: 0 10px 25px rgba(0,0,0,0.25);">
        <div class="w3-row">
          <div class="w3-col l8 m12">
            <span class="badge-pill badge-red" style="margin-bottom: 8px;">Sistema Activo</span>
            <h2 style="margin: 4px 0 8px; font-size: 24px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">
              {{ _ENV['APP_NAME'] }}
            </h2>
            <p style="margin: 0; color: #d4d4d8; font-size: 14px; line-height: 1.5; max-width: 600px;">
              Plataforma integral de venta de repuestos automotrices, trazabilidad por lote y gestión de clientes y vendedores.
            </p>
          </div>
          <div class="w3-col l4 m12" style="display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin-top: 16px;">
            <a href="/clientes/registrar" class="btn-brand">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Nuevo Cliente</span>
            </a>
            <a href="/vendedores/registrar" class="btn-secondary" style="background-color: rgba(255,255,255,0.08); color: #fff; border-color: rgba(255,255,255,0.2);">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
              </svg>
              <span>Nuevo Vendedor</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Fila de Tarjetas de Resumen (KPIs) -->
      <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <!-- KPI 1: Clientes -->
        <a href="/clientes" class="kpi-card" style="text-decoration: none; color: inherit;">
          <div class="kpi-icon red">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 12px; color: #71717a; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Clientes</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px;">Gestión</div>
            <div style="font-size: 11px; color: var(--brand-red); font-weight: 600; margin-top: 2px;">Ver directorio &rarr;</div>
          </div>
        </a>

        <!-- KPI 2: Vendedores -->
        <a href="/vendedores" class="kpi-card" style="text-decoration: none; color: inherit;">
          <div class="kpi-icon gray">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 12px; color: #71717a; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Vendedores</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px;">Equipo</div>
            <div style="font-size: 11px; color: #71717a; font-weight: 600; margin-top: 2px;">Permisos y roles &rarr;</div>
          </div>
        </a>

        <!-- KPI 3: Lotes e Inventario -->
        <div class="kpi-card">
          <div class="kpi-icon red">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div>
            <div style="font-size: 12px; color: #71717a; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Trazabilidad</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px;">Por Lote</div>
            <div style="font-size: 11px; color: #22c55e; font-weight: 600; margin-top: 2px;">Control unitario</div>
          </div>
        </div>

        <!-- KPI 4: Seguridad -->
        <a href="/actualizar-clave" class="kpi-card" style="text-decoration: none; color: inherit;">
          <div class="kpi-icon gray">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <div style="font-size: 12px; color: #71717a; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Seguridad</div>
            <div style="font-size: 22px; font-weight: 800; margin-top: 2px;">Protegido</div>
            <div style="font-size: 11px; color: #71717a; font-weight: 600; margin-top: 2px;">Cambiar contraseña &rarr;</div>
          </div>
        </a>
      </section>

      <!-- Grilla Principal: Módulos y Accesos -->
      <div class="w3-row-padding" style="margin-left: -8px; margin-right: -8px;">
