{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/update-supplier.css">
{% endblock %}

{% block title %}Actualizar Proveedor{% endblock %}

{% block content %}
<body x-data="{ sidebarOpen: false, submitting: false }">
  {{ include('components/sidebar-backdrop.twig') }}
  {{ include('components/app-sidebar.twig', {active: '/proveedores'}) }}

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    {{ include('components/app-topbar.twig', {
      title: 'Actualizar Proveedor',
      badge: 'ID #' ~ supplier['id'],
    }) }}

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan y encabezado -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/proveedores" style="color: inherit; text-decoration: none;">Proveedores</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Modificar #{{ supplier['id'] }}</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Modificar Registro de Proveedor
          </h2>
          <a href="/proveedores" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Directorio
          </a>
        </div>
      </div>

      <!-- Tarjeta del Formulario -->
      <div style="max-width: 680px; margin: 0 auto;">
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Editar Información de {{ supplier['name'] }}</span>
            </div>
            <span class="badge-pill badge-red">ID #{{ supplier['id'] }}</span>
          </div>

          <div style="padding: 24px;">
            {{ include('components/alert-error.twig') }}

            <form
              method="post"
              novalidate
              @submit="submitting = true"
            >
              <div class="w3-row-padding" style="margin: 0 -8px;">
                <!-- Nombre / Razón Social -->
                <div class="w3-col l6 m12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_name" class="form-label">
                      Razón Social / Nombre <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="text"
                      id="supplier_name"
                      name="name"
                      value="{{ supplier['name'] }}"
                      class="form-input"
                      required
                      placeholder="Nombre comercial o mercantil"
                      autofocus
                    >
                    <div class="form-hint">Nombre oficial utilizado en lotes y órdenes.</div>
                  </div>
                </div>

                <!-- RIF / Tax ID -->
                <div class="w3-col l6 m12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_tax_id" class="form-label">
                      RIF / Identificación Fiscal <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="text"
                      id="supplier_tax_id"
                      name="tax_id"
                      value="{{ supplier['tax_id'] }}"
                      class="form-input"
                      required
                      placeholder="Ej: J-12345678-9"
                    >
                    <div class="form-hint">Número tributario único del proveedor.</div>
                  </div>
                </div>
              </div>

              <div class="w3-row-padding" style="margin: 0 -8px;">
                <!-- Alias -->
                <div class="w3-col l6 m12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_alias" class="form-label">
                      Alias o Nombre Corto <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="text"
                      id="supplier_alias"
                      name="alias"
                      value="{{ supplier['alias'] }}"
                      class="form-input"
                      required
                      placeholder="Ej: Mayorista Valencia"
                    >
                    <div class="form-hint">Nombre de identificación rápida en el inventario.</div>
                  </div>
                </div>

                <!-- Vendedor / Contacto comercial -->
                <div class="w3-col l6 m12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_seller" class="form-label">
                      Vendedor / Contacto Asignado <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="text"
                      id="supplier_seller"
                      name="seller"
                      value="{{ supplier['seller'] }}"
                      class="form-input"
                      required
                      placeholder="Ej: Carlos Delgado"
                    >
                    <div class="form-hint">Asesor directo responsable de despachos.</div>
                  </div>
                </div>
              </div>

              <div class="w3-row-padding" style="margin: 0 -8px;">
                <!-- Teléfono -->
                <div class="w3-col s12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_phone" class="form-label">
                      Teléfono de Contacto <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="tel"
                      id="supplier_phone"
                      name="phone"
                      value="{{ supplier['phone'] }}"
                      class="form-input"
                      required
                      placeholder="Ej: +58 412 1234567"
                    >
                    <div class="form-hint">Teléfono para cotizaciones y seguimiento de despacho.</div>
                  </div>
                </div>
              </div>

              <div class="w3-row-padding" style="margin: 0 -8px;">
                <!-- Dirección -->
                <div class="w3-col s12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_address" class="form-label">
                      Dirección o Sede Comercial <span style="color: var(--brand-red);">*</span>
                    </label>
                    <textarea
                      id="supplier_address"
                      name="address"
                      class="form-input"
                      rows="3"
                      required
                      placeholder="Ubicación física o galpón de despacho"
                      style="resize: vertical;"
                    >{{ supplier['address'] }}</textarea>
                    <div class="form-hint">Dirección para retiro de mercancía o recepción de envíos.</div>
                  </div>
                </div>
              </div>

              <div style="margin-top: 28px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--w3-border-light); padding-top: 20px;">
                <a href="/proveedores" class="btn-secondary">
                  Cancelar
                </a>
                <button
                  type="submit"
                  class="btn-brand"
                  :disabled="submitting"
                >
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                  </svg>
                  <span x-text="submitting ? 'Guardando...' : 'Guardar Cambios'"></span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

    {{ include(
      'components/footer-guest.twig',
      {page_title: 'Modificar proveedor'},
    ) }}
  </div>

</body>
{% endblock %}
