{% extends "components/layout-guest.twig" %}

{% block head %}
  {{ parent() }}
  <link rel="stylesheet" href="/resources/styles/update-supplier.css">
{% endblock %}

{% block title %}Actualizar Proveedor{% endblock %}

{% block content %}
<body
  x-data="{
    isDarkMode: window.matchMedia('(prefers-color-scheme: dark)').matches,
    sidebarOpen: false,
    submitting: false,
    init() {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      this.isDarkMode = mediaQuery.matches;
      mediaQuery.addEventListener('change', (event) => {
        this.isDarkMode = event.matches;
      });
    }
  }"
  :class="{ 'w3-dark-mode': isDarkMode }"
>
  {{ include('components/sidebar-backdrop.twig') }}

  <!-- Barra lateral (Sidebar) -->
  <aside class="app-sidebar" :class="{ 'open': sidebarOpen }">
    <div class="sidebar-brand">
      <img
        src="/resources/images/banner.jpg"
        alt="{{ _ENV['APP_NAME'] }}"
        class="brand-avatar"
        onerror="this.style.display='none'"
      >
      <div style="overflow: hidden;">
        <div style="font-weight: 800; font-size: 13px; text-transform: uppercase; color: #ffffff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {{ _ENV['APP_NAME'] }}
        </div>
        <div style="font-size: 11px; color: #a1a1aa; display: flex; align-items: center; gap: 4px; margin-top: 2px;">
          <span style="width: 7px; height: 7px; border-radius: 50%; background-color: #22c55e; display: inline-block;"></span>
          Sistema en línea
        </div>
      </div>
    </div>

    <!-- Navegación principal -->
    <nav style="padding: 8px 0 24px;">
      <div class="nav-group-title">Principal</div>
      
      <a href="/" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Dashboard</span>
      </a>

      <div class="nav-group-title">Gestión de Negocio</div>

      <a href="/clientes" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span>Clientes</span>
      </a>

      <a href="/proveedores" class="nav-item active">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <span>Proveedores</span>
      </a>

      <a href="/vendedores" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span>Vendedores</span>
      </a>

      <a href="/cotizaciones" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Tasas de Cambio</span>
      </a>

      <div class="nav-group-title">Módulos de Repuestos</div>

      <a href="/productos" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <span>Catálogo de Productos</span>
      </a>

      <a href="/compras" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <span>Inventario y Lotes</span>
      </a>

      <a href="/ventas" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span>Ventas y Facturación</span>
      </a>

      <div class="nav-group-title">Sistema y Seguridad</div>

      <a href="/actualizar-clave" class="nav-item">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Actualizar Contraseña</span>
      </a>

      <a href="/salir" class="nav-item" style="color: #ef4444;">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Cerrar Sesión</span>
      </a>
    </nav>
  </aside>

  <!-- Área principal (Topbar + Contenido) -->
  <div class="app-main">
    <!-- Topbar -->
    <header class="app-topbar">
      <div style="display: flex; align-items: center; gap: 14px;">
        <button
          type="button"
          class="btn-secondary w3-hide-large"
          @click="sidebarOpen = true"
          aria-label="Abrir menú"
        >
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <h1 style="margin: 0; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <span>Actualizar Proveedor</span>
          <span class="badge-pill badge-red w3-hide-small">ID #{{ supplier['id'] }}</span>
        </h1>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <button
          type="button"
          class="btn-secondary"
          @click="isDarkMode = !isDarkMode"
          :title="isDarkMode ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'"
          aria-label="Alternar modo de color"
        >
          <svg x-show="isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg x-show="!isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <a href="/salir" class="btn-brand" style="padding: 7px 14px;" title="Cerrar sesión actual">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="w3-hide-small">Salir</span>
        </a>
      </div>
    </header>

    <!-- Contenido -->
    <main style="padding: 24px; flex: 1;">
      <!-- Migas de pan y encabezado -->
      <div style="margin-bottom: 24px;">
        <div style="font-size: 12px; color: #71717a; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <a href="/" style="color: inherit; text-decoration: none;">Dashboard</a>
          <span>&rsaquo;</span>
          <a href="/proveedores" style="color: inherit; text-decoration: none;">Proveedores</a>
          <span>&rsaquo;</span>
          <span style="color: var(--brand-red); font-weight: 600;">Modificar #{{ supplier['id'] }}</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px;">
            Modificar Registro de Proveedor
          </h2>
          <a href="/proveedores" class="btn-secondary" style="font-size: 13px;">
            &larr; Volver al Directorio
          </a>
        </div>
      </div>

      <!-- Tarjeta del Formulario -->
      <div style="max-width: 680px; margin: 0 auto;">
        <div class="panel-card">
          <div class="panel-header">
            <div style="font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
              <span style="width: 4px; height: 18px; background-color: var(--brand-red); border-radius: 2px;"></span>
              <span>Editar Información de {{ supplier['name'] }}</span>
            </div>
            <span class="badge-pill badge-red">ID #{{ supplier['id'] }}</span>
          </div>

          <div style="padding: 24px;">
            <!-- Notificación de Errores Flash -->
            {% if flash %}
              <div class="alert-error">
                <div style="font-weight: 700; margin-bottom: 4px;">Atención:</div>
                {% for key, error in flash %}
                  <div>&bull; {{ error is iterable ? error|join(', ') : error }}</div>
                {% endfor %}
              </div>
            {% endif %}

            <form
              method="post"
              novalidate
              @submit="submitting = true"
            >
              <div class="w3-row-padding" style="margin: 0 -8px;">
                <!-- Nombre / Razón Social -->
                <div class="w3-col l6 m12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_name" class="form-label">
                      Razón Social / Nombre <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="text"
                      id="supplier_name"
                      name="name"
                      value="{{ supplier['name'] }}"
                      class="form-input"
                      required
                      placeholder="Nombre comercial o mercantil"
                      autofocus
                    >
                    <div class="form-hint">Nombre oficial utilizado en lotes y órdenes.</div>
                  </div>
                </div>

                <!-- RIF / Tax ID -->
                <div class="w3-col l6 m12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_tax_id" class="form-label">
                      RIF / Identificación Fiscal <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="text"
                      id="supplier_tax_id"
                      name="tax_id"
                      value="{{ supplier['tax_id'] }}"
                      class="form-input"
                      required
                      placeholder="Ej: J-12345678-9"
                    >
                    <div class="form-hint">Número tributario único del proveedor.</div>
                  </div>
                </div>
              </div>

              <div class="w3-row-padding" style="margin: 0 -8px;">
                <!-- Alias -->
                <div class="w3-col l6 m12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_alias" class="form-label">
                      Alias o Nombre Corto <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="text"
                      id="supplier_alias"
                      name="alias"
                      value="{{ supplier['alias'] }}"
                      class="form-input"
                      required
                      placeholder="Ej: Mayorista Valencia"
                    >
                    <div class="form-hint">Nombre de identificación rápida en el inventario.</div>
                  </div>
                </div>

                <!-- Vendedor / Contacto comercial -->
                <div class="w3-col l6 m12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_seller" class="form-label">
                      Vendedor / Contacto Asignado <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="text"
                      id="supplier_seller"
                      name="seller"
                      value="{{ supplier['seller'] }}"
                      class="form-input"
                      required
                      placeholder="Ej: Carlos Delgado"
                    >
                    <div class="form-hint">Asesor directo responsable de despachos.</div>
                  </div>
                </div>
              </div>

              <div class="w3-row-padding" style="margin: 0 -8px;">
                <!-- Teléfono -->
                <div class="w3-col s12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_phone" class="form-label">
                      Teléfono de Contacto <span style="color: var(--brand-red);">*</span>
                    </label>
                    <input
                      type="tel"
                      id="supplier_phone"
                      name="phone"
                      value="{{ supplier['phone'] }}"
                      class="form-input"
                      required
                      placeholder="Ej: +58 412 1234567"
                    >
                    <div class="form-hint">Teléfono para cotizaciones y seguimiento de despacho.</div>
                  </div>
                </div>
              </div>

              <div class="w3-row-padding" style="margin: 0 -8px;">
                <!-- Dirección -->
                <div class="w3-col s12" style="padding: 0 8px;">
                  <div class="form-group">
                    <label for="supplier_address" class="form-label">
                      Dirección o Sede Comercial <span style="color: var(--brand-red);">*</span>
                    </label>
                    <textarea
                      id="supplier_address"
                      name="address"
                      class="form-input"
                      rows="3"
                      required
                      placeholder="Ubicación física o galpón de despacho"
                      style="resize: vertical;"
                    >{{ supplier['address'] }}</textarea>
                    <div class="form-hint">Dirección para retiro de mercancía o recepción de envíos.</div>
                  </div>
                </div>
              </div>

              <div style="margin-top: 28px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--w3-border-light); padding-top: 20px;">
                <a href="/proveedores" class="btn-secondary">
                  Cancelar
                </a>
                <button
                  type="submit"
                  class="btn-brand"
                  :disabled="submitting"
                >
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                  </svg>
                  <span x-text="submitting ? 'Guardando...' : 'Guardar Cambios'"></span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer style="padding: 20px 24px; border-top: 1px solid var(--w3-border-light); font-size: 12px; color: #71717a; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <div>
        &copy; 2026 <strong>{{ _ENV['APP_NAME'] }}</strong>. Modificar proveedor.
      </div>
      <div>
        Sistema de inventario por lote y trazabilidad comercial.
      </div>
    </footer>
  </div>

</body>
{% endblock %}
