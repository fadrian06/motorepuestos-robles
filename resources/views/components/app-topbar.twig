<header class="app-topbar">
  <div style="display: flex; align-items: center; gap: 14px;">
    <button
      type="button"
      class="btn-secondary w3-hide-large"
      @click="sidebarOpen = true"
      aria-label="Abrir menú"
    >
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <h1 style="margin: 0; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
      <span>{{ title }}</span>
      <span class="badge-pill badge-red w3-hide-small">{{ badge }}</span>
    </h1>
  </div>

  <div style="display: flex; align-items: center; gap: 10px;">
    <button
      type="button"
      class="btn-secondary"
      @click="isDarkMode = !isDarkMode"
      :title="isDarkMode ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'"
      aria-label="Alternar modo de color"
    >
      <svg x-show="isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <svg x-show="!isDarkMode" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
    </button>

    <a href="/salir" class="btn-brand" style="padding: 7px 14px;" title="Cerrar sesión actual">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <span class="w3-hide-small">Salir</span>
    </a>
  </div>
</header>
