<footer
  class="w3-center"
  style="
    margin-top: 40px;
    padding: 24px 0 12px;
    border-top: 1px solid var(--w3-border-light);
  ">
  <p class="w3-small" style="margin: 0; color: #a1a1aa; line-height: 1.8;">
    {{ text }}
    <a
      href="{{ href }}"
      class="{{ link_class }}"
      style="margin-left: 6px; display: inline-block;">
      {{ link_text }}
    </a>
  </p>
</footer>
