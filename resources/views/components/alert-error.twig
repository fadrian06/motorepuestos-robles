{% if flash %}
  <div class="alert-error">
    <div
      style="
        font-weight: 700;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
      ">
      <svg
        width="18"
        height="18"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span>{{ title ?? 'Atención' }}:</span>
    </div>
    {% for key, error in flash %}
      <div>&bull; {{ error is iterable ? error|join(', ') : error }}</div>
    {% endfor %}
  </div>
{% endif %}
