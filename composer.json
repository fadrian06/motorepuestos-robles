{
  "authors": [
    {
      "email": "franyeradriansanchez@gmail.com",
      "homepage": "https://github.com/fadrian06",
      "name": "Franyer Sánchez",
      "role": "Maintainer"
    }
  ],
  "autoload": {
    "files": [
      "app/functions.php"
    ],
    "psr-4": {
      "App\\": "app"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  },
  "description": "Sistema de ventas de repuestos con control de inventario por lote y trazabilidad de proveedor a cliente.",
  "homepage": "https://motorepuestos-robles.infinityfreeapp.com",
  "license": "proprietary",
  "repositories": {
    "faslatam/psr-framework": {
      "type": "vcs",
      "url": "https://github.com/fadrian06/psr-framework"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-pdo_mysql": "*",
    "ext-pdo_sqlite": "*",
    "faslatam/psr-framework": "dev-main",
    "guzzlehttp/guzzle": "^8.2",
    "illuminate/container": "^13.35",
    "leafs/auth": "^5.1",
    "phpmailer/phpmailer": "^7.1",
    "symfony/dotenv": "^7.4"
  },
  "require-dev": {
    "carthage-software/mago": "^1.55",
    "phpunit/phpunit": "^12.5",
    "symfony/var-dumper": "^7.4"
  },
  "scripts": {
    "format": "mago format",
    "lint": [
      "mago lint",
      "mago analyze",
      "mago guard"
    ],
    "serve": "php -S localhost:80",
    "test": "phpunit"
  },
  "type": "project"
}
